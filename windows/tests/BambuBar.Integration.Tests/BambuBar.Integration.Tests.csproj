<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests against the Docker simulators in shared/scripts/integration (windows/tools/integration-test.sh).
       Every test skips unless BAMBUBAR_INTEGRATION=1, as on the Mac. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>BambuBar.Integration.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="RepoRoot" Value="$(RepoRoot)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\BambuBar.Core\BambuBar.Core.csproj" />
  </ItemGroup>
</Project>
