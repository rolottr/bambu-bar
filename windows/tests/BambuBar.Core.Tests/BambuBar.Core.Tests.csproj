<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>BambuBar.Core.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Where the tests find shared/ (fixtures, HMS, certificates) and project.yml, like the Mac's #filePath. -->
    <AssemblyMetadata Include="RepoRoot" Value="$(RepoRoot)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\BambuBar.Core\BambuBar.Core.csproj" />
  </ItemGroup>
</Project>
