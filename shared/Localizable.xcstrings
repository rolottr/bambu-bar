    "Deactivate this installation before entering a different license. Use Check License to retry your saved activation.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před zadáním jiné licence tuto instalaci deaktivujte. Uloženou aktivaci znovu ověříte tlačítkem Zkontrolovat licenci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktivieren Sie diese Installation, bevor Sie eine andere Lizenz eingeben. Mit „Lizenz prüfen“ versuchen Sie Ihre gespeicherte Aktivierung erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactive esta instalación antes de introducir otra licencia. Use «Comprobar licencia» para reintentar con la activación guardada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez cette installation avant de saisir une autre licence. Utilisez « Vérifier la licence » pour réessayer avec votre activation enregistrée."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Másik licenc megadása előtt deaktiváld ezt a telepítést. A mentett aktiválás újbóli ellenőrzéséhez használd a Licenc ellenőrzése gombot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva questa installazione prima di inserire un'altra licenza. Usa “Controlla licenza” per riprovare con l'attivazione salvata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のライセンスを入力する前に、このインストールの認証を解除してください。保存済みの認証を再試行するには、「ライセンスを確認」を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 라이선스를 입력하기 전에 이 설치의 활성화를 해제하십시오. 저장된 활성화를 다시 시도하려면 “라이선스 확인”을 사용하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deactiveer deze installatie voordat u een andere licentie invoert. Gebruik “Controleer licentie” om uw bewaarde activatie opnieuw te proberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed wpisaniem innej licencji dezaktywuj tę instalację. Użyj przycisku Sprawdź licencję, aby ponowić weryfikację zapisanej aktywacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative esta instalação antes de inserir outra licença. Use “Verificar Licença” para tentar de novo com a ativação salva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем вводить другую лицензию, деактивируйте эту установку. Чтобы повторить сохранённую активацию, нажмите «Проверить лицензию»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaktivera den här installationen innan du anger en annan licens. Använd ”Kontrollera licens” för att försöka igen med din sparade aktivering."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Farklı bir lisans girmeden önce bu kurulumu devre dışı bırak. Kayıtlı etkinleştirmeyi yeniden denemek için Lisansı Denetle düğmesini kullan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перш ніж вводити іншу ліцензію, деактивуйте цю інсталяцію. Щоб повторити збережену активацію, натисніть «Перевірити ліцензію»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入其他许可证前，请先停用此安装。点按“检查许可证”可重试已保存的激活。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入其他授權前，請先停用此安裝。按一下「檢查授權」即可重試已儲存的啟用。"
          }
        }
      }
    },
