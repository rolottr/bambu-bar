    "Allow Bambu Bar in System Settings → General → Login Items.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte Bambu Bar v Nastavení systému → Obecné → Položky po přihlášení a rozšíření."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie Bambu Bar unter Systemeinstellungen → Allgemein → Anmeldeobjekte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita Bambu Bar en Ajustes del Sistema → General → Ítems de inicio y extensiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Bambu Bar dans Réglages Système → Général → Ouverture et extensions."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd a Bambu Bar alkalmazást itt: Rendszerbeállítások → Általános → Bejelentkezési elemek és bővítmények."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti Bambu Bar in Impostazioni di Sistema → Generali → Elementi login."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 → 一般 → ログイン項目と機能拡張でBambu Barを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 일반 → 로그인 항목에서 Bambu Bar를 허용하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta Bambu Bar toe in Systeeminstellingen → Algemeen → Inlogonderdelen en extensies."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na Bambu Bar w: Ustawienia systemowe → Ogólne → Rzeczy otwierane podczas logowania i rozszerzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o Bambu Bar em Ajustes do Sistema → Geral → Itens de Início e Extensões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите Bambu Bar в Системных настройках → Основные → Объекты входа."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt Bambu Bar i Systeminställningar → Allmänt → Inloggningsobjekt och tillägg."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları → Genel → Giriş Öğeleri bölümünde Bambu Bar'a izin ver."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте Bambu Bar у Системних параметрах → Загальні → Елементи входу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置” → “通用” → “登录项与扩展”中允许 Bambu Bar。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請前往「系統設定」→「一般」→「登入項目與延伸功能」允許 Bambu Bar。"
          }
        }
      }
    },
