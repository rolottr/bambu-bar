    "Desktop widgets are drawn by Rainmeter (GPL-2.0), shipped unmodified with its license and source.": {
      "comment": "Windows: About page credits, the bundled Rainmeter",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgety na ploše vykresluje Rainmeter (GPL-2.0), dodávaný v nezměněné podobě s licencí a zdrojovým kódem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Desktop-Widgets zeichnet Rainmeter (GPL-2.0), unverändert mitgeliefert samt Lizenz und Quellcode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los widgets de escritorio los dibuja Rainmeter (GPL-2.0), que se incluye sin modificar junto con su licencia y su código fuente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les widgets de bureau sont dessinés par Rainmeter (GPL-2.0), fourni sans modification avec sa licence et son code source."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az asztali widgeteket a Rainmeter (GPL-2.0) rajzolja meg, amelyet változatlanul, a licencével és a forráskódjával együtt mellékelünk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I widget del desktop sono disegnati da Rainmeter (GPL-2.0), incluso senza modifiche insieme alla sua licenza e al codice sorgente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップウィジェットの描画にはRainmeter（GPL-2.0）を使用しています。Rainmeterは改変せず、ライセンスとソースコードとともに同梱しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바탕 화면 위젯은 Rainmeter(GPL-2.0)가 그립니다. Rainmeter는 수정 없이 라이선스 및 소스 코드와 함께 제공됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bureaubladwidgets worden getekend door Rainmeter (GPL-2.0), ongewijzigd meegeleverd met de licentie en broncode."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Widżety na pulpicie rysuje Rainmeter (GPL-2.0), dołączony bez zmian wraz z licencją i kodem źródłowym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os widgets da área de trabalho são desenhados pelo Rainmeter (GPL-2.0), incluído sem modificações com sua licença e seu código-fonte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Виджеты на рабочем столе отрисовывает Rainmeter (GPL-2.0); он поставляется без изменений вместе с лицензией и исходным кодом."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivbordswidgetarna ritas av Rainmeter (GPL-2.0), som medföljer oförändrat tillsammans med sin licens och källkod."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masaüstü araç takımlarını Rainmeter (GPL-2.0) çizer; Rainmeter, lisansı ve kaynak koduyla birlikte değiştirilmeden sunulur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Віджети на робочому столі малює Rainmeter (GPL-2.0), що постачається без змін разом із ліцензією та вихідним кодом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面小组件由 Rainmeter（GPL-2.0）绘制，Rainmeter 未经修改，随附其许可证和源代码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面小工具由 Rainmeter（GPL-2.0）繪製，Rainmeter 未經修改，並隨附其授權條款與原始碼。"
          }
        }
      }
    },
