    "Connect to the internet to restore supporter benefits. Printer monitoring remains available.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výhody podporovatele obnovíte připojením k internetu. Sledování tiskáren zůstává dostupné."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie eine Internetverbindung her, um die Vorteile für Unterstützer wiederherzustellen. Die Druckerüberwachung bleibt verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctese a internet para recuperar las ventajas de apoyo. La monitorización de las impresoras sigue disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à Internet pour rétablir les avantages de soutien. La surveillance des imprimantes reste disponible."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csatlakozz az internethez a támogatói előnyök visszaállításához. A nyomtatófigyelés továbbra is elérhető."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connettiti a internet per ripristinare i vantaggi di supporto. Il monitoraggio delle stampanti resta disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サポーター特典を復元するには、インターネットに接続してください。プリンターの監視機能は引き続き利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "후원자 혜택을 복원하려면 인터넷에 연결하십시오. 프린터 모니터링은 계속 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak verbinding met internet om de supportervoordelen te herstellen. Printermonitoring blijft beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz się z internetem, aby przywrócić korzyści wspierającego. Monitorowanie drukarek pozostaje dostępne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte-se à internet para restaurar os benefícios de apoio. O monitoramento das impressoras continua disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключитесь к интернету, чтобы восстановить преимущества сторонника. Мониторинг принтеров по-прежнему доступен."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut till internet för att återställa stödförmånerna. Skrivarövervakningen är fortfarande tillgänglig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Destekçi avantajlarını geri getirmek için internete bağlan. Yazıcı takibi kullanılabilir olmaya devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключіться до інтернету, щоб відновити переваги прихильника. Моніторинг принтерів і далі доступний."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请联网以恢复支持者权益。打印机监控功能仍可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請連上網際網路以恢復支持者權益。印表機監控功能仍可使用。"
          }
        }
      }
    },
