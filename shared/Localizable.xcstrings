    "Couldn’t reach GitHub. Check your connection and try again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nelze se připojit ke GitHubu. Zkontrolujte připojení a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ist nicht erreichbar. Prüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo acceder a GitHub. Compruebe la conexión e inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’accéder à GitHub. Vérifiez votre connexion et réessayez."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A GitHub nem érhető el. Ellenőrizd a kapcsolatot, és próbáld újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere GitHub. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHubに接続できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub에 연결할 수 없습니다. 네트워크 연결을 확인하고 다시 시도하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan GitHub niet bereiken. Controleer uw verbinding en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się połączyć z serwisem GitHub. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar o GitHub. Verifique sua conexão e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться с GitHub. Проверьте подключение и повторите попытку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte nå GitHub. Kontrollera anslutningen och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub'a ulaşılamadı. Bağlantını kontrol et ve yeniden dene."
