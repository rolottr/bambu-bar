    "Bambu Bar can't decode this camera's video (%@).": {
      "comment": "Windows: camera error from FFmpeg; the codec, or the codec and FFmpeg's error",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar nedokáže dekódovat video z této kamery (%@)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar kann das Video dieser Kamera nicht decodieren (%@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar no puede decodificar el vídeo de esta cámara (%@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar ne peut pas décoder la vidéo de cette caméra (%@)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Bambu Bar nem tudja dekódolni ennek a kamerának a videóját (%@)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar non riesce a decodificare il video di questa telecamera (%@)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Barはこのカメラの映像をデコードできません（%@）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar가 이 카메라의 비디오를 디코딩할 수 없습니다(%@)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar kan de video van deze camera niet decoderen (%@)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar nie może zdekodować wideo z tej kamery (%@)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bambu Bar não consegue decodificar o vídeo desta câmera (%@)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar не может декодировать видео с этой камеры (%@)."
          }
        },
        "sv": {
          "stringUnit": {
