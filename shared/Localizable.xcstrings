    "In-app update checks require an active website supporter license.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrola aktualizací v aplikaci vyžaduje aktivní podporovatelskou licenci z webu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Update-Prüfungen in der App erfordern eine aktive Unterstützerlizenz von der Website."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda de actualizaciones en la app requiere una licencia de apoyo activa del sitio web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche de mises à jour dans l’app nécessite une licence de soutien active achetée sur le site."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alkalmazáson belüli frissítéskereséshez aktív, a weboldalon vásárolt támogatói licenc szükséges."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il controllo degli aggiornamenti nell'app richiede una licenza di supporto attiva acquistata sul sito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ内のアップデート確認には、有効なウェブサイトのサポーターライセンスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 내 업데이트 확인에는 유효한 웹사이트 후원자 라이선스가 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Updatecontroles in de app vereisen een actieve supporterlicentie via de website."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzanie uaktualnień w aplikacji wymaga aktywnej licencji wspierającego kupionej na stronie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A verificação de atualizações no app exige uma licença de apoio ativa comprada no site."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для проверки обновлений в приложении нужна активная лицензия сторонника, купленная на сайте."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppdateringskontroller i appen kräver en aktiv stödlicens från webbplatsen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama içi güncelleme denetimleri, web sitesinden alınmış etkin bir destekçi lisansı gerektirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірка оновлень у програмі потребує активної ліцензії прихильника, придбаної на сайті."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 内更新检查需要有效的网站支持者许可证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 內的更新檢查需要有效的網站支持者授權。"
          }
        }
      }
    },
