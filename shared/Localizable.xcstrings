    "Turn on LAN Only Liveview on the printer (Settings → Network) to see the camera here.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li zde vidět kameru, zapněte na tiskárně LAN Only Liveview (Nastavení → Síť)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie LAN Only Liveview am Drucker ein (Einstellungen → Netzwerk), um die Kamera hier zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Active LAN Only Liveview en la impresora (Configuración → Red) para ver la cámara aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez LAN Only Liveview sur l’imprimante (Paramètres → Réseau) pour voir la caméra ici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be a nyomtatón a LAN Only Liveview beállítást (Beállítások → Hálózat), hogy itt lásd a kamerát."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva LAN Only Liveview sulla stampante (Impostazioni → Rete) per vedere qui la telecamera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにカメラを表示するには、プリンターでLAN Only Liveviewをオンにしてください（プリンター画面の「設定 → ネットワーク」）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에서 카메라를 보려면 프린터에서 LAN Only Liveview를 켜십시오(프린터 화면의 설정 → 네트워크)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet LAN Only Liveview aan op de printer (Instellingen → Netwerk) om de camera hier te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz LAN Only Liveview na drukarce (Ustawienia → Sieć), aby zobaczyć tu obraz z kamery."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o LAN Only Liveview na impressora (Configurações → Rede) para ver a câmera aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы видеть здесь камеру, включите на принтере LAN Only Liveview (Настройки → Сеть)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på LAN Only Liveview på skrivaren (Inställningar → Nätverk) för att se kameran här."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerayı burada görmek için yazıcıda LAN Only Liveview seçeneğini aç (Ayarlar → Ağ)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб бачити тут камеру, увімкніть на принтері LAN Only Liveview (Налаштування → Мережа)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在打印机上开启 LAN Only Liveview（在打印机屏幕的“设置 → 网络”中），即可在此查看摄像头画面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在印表機上開啟 LAN Only Liveview（印表機螢幕上的「設定 → 網路」），即可在這裡查看攝影機畫面。"
          }
        }
      }
    },
    "Turn on LAN Only and Developer Mode on the printer to control prints from Bambu Bar.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li ovládat tisky z Bambu Bar, zapněte na tiskárně Pouze LAN a Režim vývojáře."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie Nur-LAN und den Entwicklermodus am Drucker, um Drucke über Bambu Bar zu steuern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Active Solo LAN y el Modo desarrollador en la impresora para controlar las impresiones desde Bambu Bar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez le mode LAN et le mode Développeur sur l’imprimante pour contrôler les impressions depuis Bambu Bar."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nyomtatások Bambu Bar alkalmazásból való vezérléséhez kapcsold be a LAN módot és a Fejlesztői módot a nyomtatón."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Solo LAN e Modalità sviluppatore sulla stampante per controllare le stampe da Bambu Bar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Barから造形を操作するには、プリンターでLAN専用モードと開発者モードをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar에서 출력을 제어하려면 프린터에서 LAN 전용 및 개발자 모드를 켜십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet Alleen LAN en Ontwikkelaarsmodus aan op de printer om prints vanuit Bambu Bar te bedienen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz tryb Tylko LAN i tryb programisty na drukarce, aby sterować wydrukami z Bambu Bar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative Somente LAN e o Modo de desenvolvedor na impressora para controlar impressões pelo Bambu Bar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы управлять печатью из Bambu Bar, включите на принтере режим «Только локальная сеть» и режим разработчика."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Endast LAN och Utvecklarläge på skrivaren för att styra utskrifter från Bambu Bar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baskıları Bambu Bar'dan kontrol etmek için yazıcıda Yalnızca LAN ve Geliştirici Modu'nu aç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб керувати друком із Bambu Bar, увімкніть на принтері «Лише LAN» і режим розробника."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在打印机上打开“仅局域网”和“开发者模式”，即可通过 Bambu Bar 控制打印。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在印表機上開啟「僅區域網路」和「開發者模式」，即可從 Bambu Bar 控制列印。"
          }
        }
      }
    },
    "Turn the camera on for each printer too, on the Printers page. While it's off, the camera is hidden everywhere: the Printer page, the menu bar panel and the menus.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameru zapněte také u každé tiskárny na stránce Tiskárny. Dokud je tato volba vypnutá, kamera je skrytá všude: na stránce Tiskárna, v panelu v řádku nabídek i v nabídkách."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie die Kamera zusätzlich für jeden Drucker ein, auf der Seite „Druckerverwaltung“. Solange diese Option aus ist, ist die Kamera überall ausgeblendet: auf der Seite „Drucker“, im Menüleisten-Panel und in den Menüs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Active también la cámara de cada impresora en la página Impresoras. Mientras esta opción esté desactivada, la cámara se oculta en todas partes: la página Impresora, el panel de la barra de menús y los menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez aussi la caméra de chaque imprimante dans la page Imprimantes. Tant que ce réglage est désactivé, la caméra est masquée partout : la page Imprimante, le panneau de la barre des menus et les menus."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kamerát minden nyomtatónál külön is kapcsold be a Nyomtatók lapon. Amíg ez ki van kapcsolva, a kamera mindenhol rejtve marad: a Nyomtató lapon, a menüsor-panelen és a menükben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva la telecamera anche per ogni stampante, nella pagina Stampanti. Finché questa opzione è disattivata, la telecamera è nascosta ovunque: nella pagina Stampante, nel pannello della barra dei menu e nei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「プリンター管理」ページでも、プリンターごとにカメラをオンにしてください。この設定がオフの間は、「プリンター」ページ、メニューバーパネル、メニューのすべてでカメラが非表示になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프린터 관리 페이지에서도 프린터마다 카메라를 켜십시오. 이 설정이 꺼져 있으면 프린터 페이지, 메뉴 막대 패널, 메뉴 등 모든 곳에서 카메라가 숨겨집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet de camera ook per printer aan, op de pagina Printers. Zolang deze optie uit staat, is de camera overal verborgen: op de pagina Printer, in het menubalkpaneel en in de menu’s."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz też kamerę dla każdej drukarki na stronie Drukarki. Gdy ta opcja jest wyłączona, kamera jest ukryta wszędzie: na stronie Drukarka, w panelu na pasku menu i w menu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative também a câmera de cada impressora na página Impressoras. Enquanto esta opção estiver desligada, a câmera fica oculta em todo lugar: na página Impressora, no painel da barra de menus e nos menus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите камеру и для каждого принтера — на странице «Принтеры». Пока этот параметр выключен, камера скрыта везде: на странице «Принтер», в панели строки меню и в меню."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå också på kameran för varje skrivare på sidan Hantera skrivare. När det här är avstängt döljs kameran överallt: på sidan Skrivare, i menyradspanelen och i menyerna."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerayı ayrıca Yazıcılar sayfasında her yazıcı için de aç. Bu ayar kapalıyken kamera her yerde gizlenir: Yazıcı sayfasında, menü çubuğu panelinde ve menülerde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Також увімкніть камеру для кожного принтера на сторінці «Принтери». Поки цей параметр вимкнено, камеру приховано всюди: на сторінці «Принтер», на панелі в смузі меню та в меню."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还需要在“打印机管理”页面为每台打印机开启摄像头。此项关闭时，摄像头在所有位置都会隐藏：“打印机”页面、菜单栏面板和菜单中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還需要在「印表機管理」頁面為每台印表機開啟攝影機。此選項關閉時，攝影機在所有地方都會隱藏：「印表機」頁面、選單列面板和選單。"
          }
        }
      }
    },
    "Turn the camera on for each printer too, on the Printers page. While it's off, the camera is hidden everywhere: the Printer page, the tray panel and the menus.": {
      "comment": "Windows: Settings page, below the camera switch (the Mac's names the menu bar panel)",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameru zapněte také u každé tiskárny na stránce Tiskárny. Dokud je tato volba vypnutá, kamera je skrytá všude: na stránce Tiskárna, v panelu oznamovací oblasti i v nabídkách."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie die Kamera zusätzlich für jeden Drucker ein, auf der Seite „Druckerverwaltung“. Solange diese Option aus ist, ist die Kamera überall ausgeblendet: auf der Seite „Drucker“, im Panel des Infobereichs und in den Menüs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Active también la cámara de cada impresora en la página Impresoras. Mientras esta opción esté desactivada, la cámara se oculta en todas partes: la página Impresora, el panel del área de notificación y los menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez aussi la caméra de chaque imprimante dans la page Imprimantes. Tant que ce réglage est désactivé, la caméra est masquée partout : la page Imprimante, le panneau de la zone de notification et les menus."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kamerát minden nyomtatónál külön is kapcsold be a Nyomtatók lapon. Amíg ez ki van kapcsolva, a kamera mindenhol rejtve marad: a Nyomtató lapon, az értesítési terület paneljén és a menükben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva la telecamera anche per ogni stampante, nella pagina Stampanti. Finché questa opzione è disattivata, la telecamera è nascosta ovunque: nella pagina Stampante, nel pannello dell'area di notifica e nei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「プリンター管理」ページでも、プリンターごとにカメラをオンにしてください。この設定がオフの間は、「プリンター」ページ、通知領域のパネル、メニューのすべてでカメラが非表示になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프린터 관리 페이지에서도 프린터마다 카메라를 켜십시오. 이 설정이 꺼져 있으면 프린터 페이지, 알림 영역 패널, 메뉴 등 모든 곳에서 카메라가 숨겨집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet de camera ook per printer aan, op de pagina Printers. Zolang deze optie uit staat, is de camera overal verborgen: op de pagina Printer, in het systeemvakpaneel en in de menu’s."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz też kamerę dla każdej drukarki na stronie Drukarki. Gdy ta opcja jest wyłączona, kamera jest ukryta wszędzie: na stronie Drukarka, w panelu obszaru powiadomień i w menu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative também a câmera de cada impressora na página Impressoras. Enquanto esta opção estiver desligada, a câmera fica oculta em todo lugar: na página Impressora, no painel da área de notificação e nos menus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите камеру и для каждого принтера — на странице «Принтеры». Пока этот параметр выключен, камера скрыта везде: на странице «Принтер», в панели области уведомлений и в меню."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå också på kameran för varje skrivare på sidan Hantera skrivare. När det här är avstängt döljs kameran överallt: på sidan Skrivare, i panelen i meddelandefältet och i menyerna."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerayı ayrıca Yazıcılar sayfasında her yazıcı için de aç. Bu ayar kapalıyken kamera her yerde gizlenir: Yazıcı sayfasında, bildirim alanı panelinde ve menülerde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Також увімкніть камеру для кожного принтера на сторінці «Принтери». Поки цей параметр вимкнено, камеру приховано всюди: на сторінці «Принтер», на панелі в області сповіщень та в меню."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还需要在“打印机管理”页面为每台打印机开启摄像头。此项关闭时，摄像头在所有位置都会隐藏：“打印机”页面、通知区域面板和菜单中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還需要在「印表機管理」頁面為每台印表機開啟攝影機。此選項關閉時，攝影機在所有地方都會隱藏：「印表機」頁面、通知區域面板和選單。"
          }
        }
      }
    },
