          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас версія %@. Bambu Bar встановить оновлення й перезапуститься."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前版本为 %@。Bambu Bar 会安装更新并重新启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您目前使用的是 %@。Bambu Bar 會安裝更新項目並重新啟動。"
          }
        }
      }
    },
    "Your Bambu Lab printer, one click away in the menu bar.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše tiskárna Bambu Lab na jedno kliknutí v řádku nabídek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Drucker von Bambu Lab, nur einen Klick entfernt in der Menüleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su impresora Bambu Lab, a un clic en la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre imprimante Bambu Lab, à un clic dans la barre des menus."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Bambu Lab nyomtatód egy kattintásra a menüsorban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua stampante Bambu Lab, a un clic dalla barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Labプリンターを、メニューバーからワンクリックで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대에서 클릭 한 번으로 만나는 Bambu Lab 프린터."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw Bambu Lab-printer, met één klik bereikbaar in de menubalk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja drukarka Bambu Lab o jedno kliknięcie, na pasku menu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua impressora Bambu Lab a um clique, na barra de menus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш принтер Bambu Lab — в один клик из строки меню."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Bambu Lab-skrivare, ett klick bort i menyraden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Lab yazıcın, menü çubuğunda bir tık uzağında."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш принтер Bambu Lab — за один клік у смузі меню."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在菜单栏中一键查看您的 Bambu Lab 打印机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在選單列按一下，即可查看您的 Bambu Lab 印表機。"
          }
        }
      }
    },
