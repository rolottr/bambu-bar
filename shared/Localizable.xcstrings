    "Widgets aren't available in this run of Bambu Bar.": {
      "comment": "Windows: Widgets page, tooltip on the disabled “Add Widget” button when the widget engine didn't start",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgety nejsou v tomto spuštění Bambu Bar k dispozici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgets sind in dieser Sitzung von Bambu Bar nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los widgets no están disponibles en esta ejecución de Bambu Bar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les widgets ne sont pas disponibles pour cette exécution de Bambu Bar."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A widgetek a Bambu Bar mostani futása során nem érhetők el."
          }
        },
        "it": {
