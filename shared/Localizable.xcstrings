    "The camera isn't streaming (%@). Is LAN Only Liveview on?": {
      "comment": "The camera's RTSP status line, such as 454 Session Not Found",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera nestreamuje (%@). Je zapnuté LAN Only Liveview?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera streamt nicht (%@). Ist LAN Only Liveview eingeschaltet?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara no está transmitiendo (%@). ¿Está activado LAN Only Liveview?"
          }
        },
        "fr": {
          "stringUnit": {
