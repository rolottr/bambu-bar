    "Cannot reach the licensing service right now. Check your internet connection and try again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Licenční službu teď nelze kontaktovat. Zkontrolujte připojení k internetu a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Lizenzdienst ist gerade nicht erreichbar. Prüfen Sie Ihre Internetverbindung und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder al servicio de licencias en este momento. Compruebe la conexión a internet e inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre le service de licences pour le moment. Vérifiez votre connexion à Internet et réessayez."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A licencszolgáltatás most nem érhető el. Ellenőrizd az internetkapcsolatot, és próbáld újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere il servizio licenze in questo momento. Controlla la connessione a internet e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、ライセンスサービスに接続できません。インターネット接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 라이선스 서비스에 연결할 수 없습니다. 인터넷 연결을 확인하고 다시 시도하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De licentieservice is nu niet bereikbaar. Controleer uw internetverbinding en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można teraz połączyć się z usługą licencyjną. Sprawdź połączenie z internetem i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível acessar o serviço de licenças agora. Verifique sua conexão com a internet e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас не удаётся связаться со службой лицензирования. Проверьте подключение к интернету и повторите попытку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det går inte att nå licenstjänsten just nu. Kontrollera internetanslutningen och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisans hizmetine şu anda ulaşılamıyor. İnternet bağlantını kontrol et ve yeniden dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз не вдається з’єднатися зі службою ліцензування. Перевірте підключення до інтернету і спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前无法连接许可服务。请检查网络连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法連上授權服務。請檢查網路連線後再試一次。"
          }
        }
      }
    },
