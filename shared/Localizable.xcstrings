    "%@ Check the IP address on the printer's screen (Settings → Network).": {
      "comment": "A sentence on why the printer couldn't be reached comes first",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Zkontrolujte IP adresu na obrazovce tiskárny (Nastavení → Síť)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Prüfen Sie die IP-Adresse auf dem Druckerdisplay (Einstellungen → Netzwerk)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Compruebe la dirección IP en la pantalla de la impresora (Configuración → Red)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vérifiez l’adresse IP sur l’écran de l’imprimante (Paramètres → Réseau)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ellenőrizd az IP-címet a nyomtató képernyőjén (Beállítások → Hálózat)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Controlla l'indirizzo IP sullo schermo della stampante (Impostazioni → Rete)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ プリンターの画面（設定 → ネットワーク）でIPアドレスを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 프린터 화면(설정 → 네트워크)에서 IP 주소를 확인하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Controleer het IP-adres op het scherm van de printer (Instellingen → Netwerk)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Sprawdź adres IP na ekranie drukarki (Ustawienia → Sieć)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Confira o endereço IP na tela da impressora (Configurações → Rede)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Проверьте IP-адрес на экране принтера (Настройки → Сеть)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Kontrollera IP-adressen på skrivarens skärm (Inställningar → Nätverk)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ IP adresini yazıcının ekranında kontrol et (Ayarlar → Ağ)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Перевірте IP-адресу на екрані принтера (Налаштування → Мережа)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@请在打印机屏幕的“设置 → 网络”中查看 IP 地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@請在印表機螢幕上（設定 → 網路）確認 IP 位址。"
          }
        }
      }
    },
    "%@ If an activation appeared in your account, remove it there before retrying.": {
      "comment": "A licensing error message, then advice",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Pokud se ve vašem zákaznickém účtu objevila aktivace, před dalším pokusem ji tam odeberte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Falls in Ihrem Kundenkonto eine Aktivierung erschienen ist, entfernen Sie sie dort, bevor Sie es erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Si apareció una activación en su cuenta de compra, elimínela allí antes de volver a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Si une activation est apparue dans votre compte client, supprimez-la avant de réessayer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ha megjelent egy aktiválás a vásárlói fiókodban, az újbóli próbálkozás előtt távolítsd el ott."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Se nel tuo account acquisti è comparsa un'attivazione, rimuovila da lì prima di riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 購入アカウントに認証が表示されている場合は、再試行する前にそこで削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 구매 계정에 활성화가 표시되면 다시 시도하기 전에 그곳에서 제거하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Als er een activatie in uw klantaccount is verschenen, verwijder die daar dan voordat u het opnieuw probeert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Jeśli na Twoim koncie klienta pojawiła się aktywacja, usuń ją tam przed ponowną próbą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Se uma ativação apareceu na sua conta de compra, remova-a lá antes de tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Если в вашем аккаунте появилась активация, удалите её там, прежде чем повторить попытку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Om en aktivering har dykt upp i ditt kundkonto tar du bort den där innan du försöker igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Hesabında bir etkinleştirme göründüyse yeniden denemeden önce onu oradan kaldır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Якщо у вашому обліковому записі з’явилася активація, видаліть її там, перш ніж спробувати знову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@如果您的购买账户中已出现激活记录，请先在那里将其移除，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@如果您的購買帳戶中已出現啟用紀錄，請先在那裡將其移除，再試一次。"
          }
        }
      }
    },
