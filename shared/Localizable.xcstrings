    "Automatic shows whichever printer is busy (paused first, then printing), otherwise the one you last looked at.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky se zobrazí tiskárna, která právě pracuje (nejdřív pozastavená, pak tisknoucí), jinak ta, kterou jste si prohlíželi naposledy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Automatisch“ zeigt den Drucker, der gerade beschäftigt ist (zuerst pausierte, dann druckende), sonst den zuletzt angesehenen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Automático» muestra la impresora que esté ocupada (primero en pausa, luego imprimiendo) o, si no, la última que consultó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique affiche l’imprimante occupée (en pause d’abord, puis en impression), sinon la dernière consultée."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Automatikus beállítás az éppen dolgozó nyomtatót mutatja (elsőként a szüneteltetettet, majd a nyomtatást végzőt), egyébként azt, amelyiket utoljára nézted."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In automatico mostra la stampante occupata (prima quella in pausa, poi quella in stampa), altrimenti l'ultima che hai guardato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」では、稼働中のプリンター（一時停止中を優先し、次に造形中）を表示します。稼働中のプリンターがない場合は、最後に見たプリンターを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동은 작업 중인 프린터(일시정지된 프린터 우선, 그다음 출력 중인 프린터)를 표시하고, 없으면 마지막으로 본 프린터를 표시합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“Automatisch” toont de printer die bezig is (eerst gepauzeerd, dan printend), anders de printer die u het laatst bekeek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb automatyczny pokazuje zajętą drukarkę (najpierw wstrzymaną, potem drukującą), a gdy żadna nie jest zajęta – ostatnio oglądaną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático mostra a impressora que estiver ocupada (primeiro as pausadas, depois as imprimindo); senão, a última que você viu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В режиме «Автоматически» показывается занятый принтер (сначала на паузе, затем печатающий), а если таких нет — последний просмотренный."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatiskt visar den skrivare som är upptagen (först pausade, sedan de som skriver ut), annars den du tittade på senast."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik, meşgul olan yazıcıyı gösterir (önce duraklatılmış, sonra yazdıran); yoksa en son baktığın yazıcıyı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Автоматично» показує зайнятий принтер (спершу той, що на паузі, потім той, що друкує), інакше — останній переглянутий."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动”会显示正在工作的打印机（优先显示已暂停的，其次是打印中的），否则显示您上次查看的打印机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」會顯示正在忙碌的印表機（優先顯示已暫停的，其次是列印中的），否則顯示您上次查看的印表機。"
          }
        }
      }
    },
