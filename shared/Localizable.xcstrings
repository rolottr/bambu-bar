    "Activate your website supporter license to check GitHub for updates and enable automatic updates.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivujte podporovatelskou licenci z webu, abyste mohli vyhledávat aktualizace na GitHubu a zapnout automatické aktualizace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie Ihre Unterstützerlizenz von der Website, um auf GitHub nach Updates zu suchen und automatische Updates einzuschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Active su licencia de apoyo del sitio web para buscar actualizaciones en GitHub y activar las actualizaciones automáticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez votre licence de soutien achetée sur le site pour rechercher les mises à jour sur GitHub et activer les mises à jour automatiques."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiváld a weboldalon vásárolt támogatói licencedet, hogy frissítéseket kereshess a GitHubon, és bekapcsolhasd az automatikus frissítéseket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva la licenza di supporto acquistata sul sito per controllare gli aggiornamenti su GitHub e abilitare gli aggiornamenti automatici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウェブサイトで購入したサポーターライセンスを認証すると、GitHubでアップデートを確認したり、自動アップデートを有効にしたりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹사이트 후원자 라이선스를 활성화하면 GitHub에서 업데이트를 확인하고 자동 업데이트를 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Activeer uw supporterlicentie van de website om op GitHub op updates te controleren en automatische updates in te schakelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywuj licencję wspierającego kupioną na stronie, aby sprawdzać uaktualnienia w serwisie GitHub i włączyć automatyczne uaktualnienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative sua licença de apoio comprada no site para verificar atualizações no GitHub e ativar as atualizações automáticas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активируйте лицензию сторонника, купленную на сайте, чтобы проверять обновления на GitHub и включить автоматические обновления."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera din stödlicens från webbplatsen för att söka efter uppdateringar på GitHub och slå på automatiska uppdateringar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub'da güncellemeleri denetlemek ve otomatik güncellemeleri açmak için web sitesinden aldığın destekçi lisansını etkinleştir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Активуйте ліцензію прихильника, придбану на сайті, щоб перевіряти оновлення на GitHub і ввімкнути автоматичні оновлення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "激活您的网站支持者许可证，即可从 GitHub 检查更新并启用自动更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用網站支持者授權後，即可從 GitHub 檢查更新項目並開啟自動更新。"
          }
        }
      }
    },
