    "Show pause, resume, stop and print speed controls in the menu bar panel and main window, and print actions in the Printer menu.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí ovládání pozastavení, pokračování, zastavení a rychlosti tisku v panelu v řádku nabídek a v hlavním okně a akce tisku v nabídce Tiskárna."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Steuerelemente für Pausieren, Fortsetzen, Stoppen und Druckgeschwindigkeit im Menüleisten-Panel und im Hauptfenster sowie Druckaktionen im Menü „Drucker“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los controles de pausa, reanudación, detención y velocidad de impresión en el panel de la barra de menús y en la ventana principal, y las acciones de impresión en el menú Impresora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les commandes de pause, de reprise, d’arrêt et de vitesse d’impression dans le panneau de la barre des menus et la fenêtre principale, ainsi que les actions d’impression dans le menu Imprimante."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megjeleníti a szüneteltetés, a folytatás, a leállítás és a nyomtatási sebesség vezérlőit a menüsor-panelen és a főablakban, valamint a nyomtatási műveleteket a Nyomtató menüben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra i controlli di pausa, ripresa, interruzione e velocità di stampa nel pannello della barra dei menu e nella finestra principale, e le azioni di stampa nel menu Stampante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーパネルとメインウインドウに一時停止、再開、中止、造形速度のコントロールを表示し、「プリンター」メニューに造形の操作を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대 패널과 메인 윈도우에 일시정지, 재개, 중지 및 출력 속도 제어를 표시하고, 프린터 메뉴에 출력 제어 항목을 표시합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont bediening voor pauzeren, hervatten, stoppen en printsnelheid in het menubalkpaneel en het hoofdvenster, en printacties in het menu Printer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje przyciski wstrzymania, wznowienia, zatrzymania i prędkości druku w panelu na pasku menu i w oknie głównym oraz polecenia wydruku w menu Drukarka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra os controles de pausar, retomar, parar e velocidade de impressão no painel da barra de menus e na janela principal, e as ações de impressão no menu Impressora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать кнопки паузы, возобновления, остановки и скорости печати в панели строки меню и в главном окне, а действия с печатью — в меню «Принтер»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar reglage för att pausa, återuppta och stoppa samt utskriftshastighet i menyradspanelen och huvudfönstret, och utskriftsåtgärder i menyn Skrivare."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duraklatma, sürdürme, durdurma ve baskı hızı denetimlerini menü çubuğu panelinde ve ana pencerede, baskı eylemlerini de Yazıcı menüsünde göster."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати кнопки паузи, продовження, зупинки й швидкості друку на панелі в смузі меню та в головному вікні, а дії з друком — у меню «Принтер»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在菜单栏面板和主窗口中显示暂停、继续、停止和打印速度控制，并在“打印机”菜单中显示打印操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在選單列面板和主視窗中顯示暫停、繼續、停止和列印速度控制項目，並在「印表機」選單中顯示列印操作。"
          }
        }
      }
    },
    "Show pause, resume, stop and print speed controls in the tray panel and the main window, and print actions in the tray icon's menu.": {
      "comment": "Windows: Tray page, the print controls switch's note (the Mac's names the menu bar and the Printer menu)",
      "localizations": {
