            "value": "Оставшееся время"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återstående tid"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalan süre"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок часу"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剩余时间"
          }
        },
        "zh-Hant": {
