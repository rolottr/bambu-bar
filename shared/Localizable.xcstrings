    "%@ doesn't know %@. Pick another printer or type the code.": {
      "comment": "A file name, then a serial number",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nezná tiskárnu %@. Vyberte jinou tiskárnu nebo zadejte kód."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kennt %@ nicht. Wählen Sie einen anderen Drucker oder geben Sie den Code ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ doesn't know %2$@. Pick another printer or type the code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no incluye %2$@. Elija otra impresora o introduzca el código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne contient pas de code pour %@. Choisissez une autre imprimante ou saisissez le code."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ kódja nem található itt: %1$@. Válassz másik nyomtatót, vagy írd be a kódot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non contiene %@. Scegli un'altra stampante o digita il codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@に%2$@の情報がありません。別のプリンターを選ぶか、コードを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 %@ 정보가 없습니다. 다른 프린터를 선택하거나 코드를 입력하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kent %@ niet. Kies een andere printer of typ de code."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nie zawiera kodu dla %2$@. Wybierz inną drukarkę lub wpisz kod."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não inclui %@. Escolha outra impressora ou digite o código."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В %@ нет кода для %@. Выберите другой принтер или введите код."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ känner inte till %@. Välj en annan skrivare eller skriv in koden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ içinde %2$@ bulunamadı. Başka bir yazıcı seç veya kodu yaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У %@ немає коду для %@. Виберіть інший принтер або введіть код."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 中没有 %@ 的访问码。请选择其他打印机，或手动输入访问码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 中沒有 %@ 的資料。請選擇其他印表機，或手動輸入存取碼。"
          }
        }
      }
    },
    "%@ doesn't know this printer. Pick another printer or type the code.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tuto tiskárnu nezná. Vyberte jinou tiskárnu nebo zadejte kód."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kennt diesen Drucker nicht. Wählen Sie einen anderen Drucker oder geben Sie den Code ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no incluye esta impresora. Elija otra impresora o introduzca el código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne contient pas de code pour cette imprimante. Choisissez une autre imprimante ou saisissez le code."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennek a nyomtatónak a kódja nem található itt: %@. Válassz másik nyomtatót, vagy írd be a kódot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non contiene questa stampante. Scegli un'altra stampante o digita il codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にこのプリンターの情報がありません。別のプリンターを選ぶか、コードを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 이 프린터 정보가 없습니다. 다른 프린터를 선택하거나 코드를 입력하십시오."
          }
        },
        "nl": {
          "stringUnit": {
