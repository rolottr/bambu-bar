    "Manage your active installations in your account. Deactivate an old installation to make room for another.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivní instalace spravujete ve svém zákaznickém účtu. Deaktivací staré instalace uvolníte místo pro další."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwalten Sie Ihre aktiven Installationen in Ihrem Kundenkonto. Deaktivieren Sie eine alte Installation, um Platz für eine neue zu schaffen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestione sus instalaciones activas en su cuenta de compra. Desactive una instalación antigua para dejar sitio a otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez vos installations actives dans votre compte client. Désactivez une ancienne installation pour faire de la place à une autre."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az aktív telepítéseidet a vásárlói fiókodban kezelheted. Egy régi telepítés deaktiválásával helyet szabadíthatsz fel egy újnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci le installazioni attive nel tuo account acquisti. Disattiva una vecchia installazione per fare spazio a un'altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なインストールは購入アカウントで管理できます。古いインストールの認証を解除すると、別のインストールに使える枠が空きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 설치는 구매 계정에서 관리하십시오. 이전 설치의 활성화를 해제하면 다른 설치에 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheer uw actieve installaties in uw klantaccount. Deactiveer een oude installatie om ruimte te maken voor een nieuwe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywnymi instalacjami zarządzasz na swoim koncie klienta. Dezaktywuj starą instalację, aby zwolnić miejsce na kolejną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie suas instalações ativas na sua conta de compra. Desative uma instalação antiga para liberar espaço para outra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляйте активными установками в своём аккаунте. Деактивируйте старую установку, чтобы освободить место для новой."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hantera dina aktiva installationer i ditt kundkonto. Avaktivera en gammal installation för att göra plats för en ny."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin kurulumlarını hesabından yönet. Başka bir kuruluma yer açmak için eski bir kurulumu devre dışı bırak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Керуйте активними інсталяціями у своєму обліковому записі. Деактивуйте стару інсталяцію, щоб звільнити місце для нової."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在您的购买账户中管理已激活的安装。停用旧的安装，即可为其他安装腾出名额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在您的購買帳戶中管理已啟用的安裝。停用舊的安裝，即可為其他安裝騰出名額。"
          }
        }
      }
    },
