          }
        }
      }
    },
    "The update couldn’t be saved. Check that your disk has free space and try again.": {
      "comment": "Windows: updater error, the downloaded installer couldn't be written to disk",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizaci se nepodařilo uložit. Zkontrolujte, zda je na disku volné místo, a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Update konnte nicht gespeichert werden. Prüfen Sie, ob auf dem Datenträger genügend Speicherplatz frei ist, und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la actualización. Compruebe que haya espacio libre en el disco e inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise à jour n’a pas pu être enregistrée. Vérifiez qu’il reste de l’espace libre sur votre disque et réessayez."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A frissítést nem sikerült menteni. Ellenőrizd, hogy van-e szabad hely a lemezen, és próbáld újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare l'aggiornamento. Controlla che sul disco ci sia spazio libero e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートを保存できませんでした。ディスクに空き容量があることを確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트를 저장할 수 없습니다. 디스크에 여유 공간이 있는지 확인하고 다시 시도하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De update kan niet worden bewaard. Controleer of er vrije ruimte op uw schijf is en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać uaktualnienia. Sprawdź, czy na dysku jest wolne miejsce, i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar a atualização. Verifique se há espaço livre no disco e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить обновление. Убедитесь, что на диске есть свободное место, и повторите попытку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppdateringen kunde inte sparas. Kontrollera att det finns ledigt utrymme på disken och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncelleme kaydedilemedi. Diskinde boş alan olduğunu kontrol et ve yeniden dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти оновлення. Перевірте, чи є вільне місце на диску, і спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存更新。请检查磁盘是否有可用空间，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存更新項目。請檢查磁碟是否有可用空間，然後再試一次。"
          }
        }
      }
    },
    "The update feed couldn’t be read. Please try again later.": {
      "comment": "Windows: updater error, the update feed (appcast) couldn't be downloaded or read",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanál aktualizací se nepodařilo načíst. Zkuste to prosím později."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Update-Feed konnte nicht gelesen werden. Bitte versuchen Sie es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el feed de actualización. Inténtelo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le flux de mise à jour n’a pas pu être lu. Réessayez plus tard."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A frissítési csatornát nem sikerült beolvasni. Próbáld újra később."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere il feed di aggiornamento. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートフィードを読み込めませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트 피드를 읽을 수 없습니다. 나중에 다시 시도하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De updatefeed kan niet worden gelezen. Probeer het later opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać kanału uaktualnień. Spróbuj ponownie później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o feed de atualização. Tente novamente mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать канал обновлений. Повторите попытку позже."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppdateringsflödet kunde inte läsas. Försök igen senare."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncelleme akışı okunamadı. Lütfen daha sonra yeniden dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати канал оновлень. Спробуйте пізніше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取更新源。请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取更新來源。請稍後再試一次。"
          }
        }
      }
    },
    "Their access codes are saved there, so they can all be added at once.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jejich přístupové kódy jsou tam uložené, takže je lze přidat všechny najednou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Zugangscodes sind dort gespeichert, daher können alle auf einmal hinzugefügt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus códigos de acceso están guardados ahí, así que se pueden añadir todas a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leurs codes d’accès y sont enregistrés, elles peuvent donc toutes être ajoutées en une fois."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hozzáférési kódjaik ott vannak mentve, így egyszerre hozzáadhatod mindet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I loro codici di accesso sono salvati lì, quindi puoi aggiungerle tutte in una volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そこにアクセスコードが保存されているため、まとめて追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그곳에 액세스 코드가 저장되어 있으므로 한 번에 모두 추가할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hun toegangscodes zijn daar bewaard, dus ze kunnen allemaal tegelijk worden toegevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kody dostępu są tam zapisane, więc można je dodać wszystkie naraz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os códigos de acesso delas estão salvos lá, então todas podem ser adicionadas de uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Там сохранены их коды доступа, поэтому все принтеры можно добавить сразу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Deras åtkomstkoder är sparade där, så alla kan läggas till på en gång."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişim kodları orada kayıtlı olduğundan hepsi tek seferde eklenebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Там збережено їхні коди доступу, тож усі принтери можна додати одразу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其中保存了这些打印机的访问码，因此可以一次性全部添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其中已儲存這些印表機的存取碼，因此可以一次全部加入。"
          }
        }
      }
    },
