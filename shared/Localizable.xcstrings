    },
    "Ask before stopping a print": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před zastavením tisku se zeptat"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Stoppen eines Drucks nachfragen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntar antes de detener una impresión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander avant d’arrêter une impression"
          }
        },
        "hu": {
