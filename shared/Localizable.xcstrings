    "Dismiss until the printer clears it": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrýt, dokud tiskárna hlášení nezruší"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausblenden, bis der Drucker die Meldung aufhebt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar hasta que la impresora lo borre"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer jusqu’à ce que l’imprimante l’efface"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elrejtés, amíg a nyomtató nem törli az üzenetet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi finché la stampante non lo cancella"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリンターが解除するまで非表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프린터가 해제할 때까지 숨기기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verberg tot de printer de melding wist"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukryj, dopóki drukarka nie usunie komunikatu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar até a impressora remover o aviso"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрыть, пока принтер не сбросит сообщение"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dölj tills skrivaren tar bort meddelandet"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazıcı mesajı kaldırana kadar gizle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приховати, доки принтер не скине повідомлення"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏此消息，直到打印机将其清除"
