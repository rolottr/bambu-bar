    "It makes no other network requests. Updates come from the App Store.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádné další síťové požadavky neodesílá. Aktualizace přicházejí z App Storu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Netzwerkanfragen gibt es nicht. Updates kommen aus dem App Store."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No realiza ninguna otra solicitud de red. Las actualizaciones llegan desde el App Store."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle ne fait aucune autre requête réseau. Les mises à jour viennent de l’App Store."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Más hálózati kérést nem küld. A frissítések az App Store-ból érkeznek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non effettua altre richieste di rete. Gli aggiornamenti arrivano dall'App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それ以外のネットワーク通信は行いません。アップデートはApp Storeから配信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 외의 네트워크 요청은 하지 않습니다. 업데이트는 App Store에서 제공됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen andere netwerkverzoeken. Updates komen uit de App Store."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wykonuje żadnych innych połączeń sieciowych. Uaktualnienia pochodzą z App Store."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele não faz nenhuma outra solicitação de rede. As atualizações vêm da App Store."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Других сетевых запросов нет. Обновления приходят из App Store."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gör inga andra nätverksförfrågningar. Uppdateringar kommer från App Store."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka hiçbir ağ isteği yapmaz. Güncellemeler App Store'dan gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інших мережевих запитів немає. Оновлення надходять з App Store."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它不会发出其他任何网络请求。更新来自 App Store。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它不會發出其他任何網路連線。更新項目來自 App Store。"
          }
        }
      }
    },
    "It starts quietly in the menu bar, without a Dock icon.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spouští se nenápadně v řádku nabídek, bez ikony v Docku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App startet unauffällig in der Menüleiste, ohne Dock-Symbol."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se inicia discretamente en la barra de menús, sin icono en el Dock."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il démarre discrètement dans la barre des menus, sans icône dans le Dock."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csendben, a menüsorban indul el, Dock-ikon nélkül."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si avvia in silenzio nella barra dei menu, senza icona nel Dock."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dockアイコンなしで、メニューバーで静かに起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 아이콘 없이 메뉴 막대에서 조용히 시작됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app start stil in de menubalk, zonder Dock-symbool."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchamia się po cichu na pasku menu, bez ikony w Docku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele abre discretamente na barra de menus, sem ícone no Dock."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение тихо запускается в строке меню, без значка в Dock."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den startar diskret i menyraden, utan symbol i Dock."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock simgesi olmadan, sessizce menü çubuğunda başlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програма тихо запускається в смузі меню, без значка в Dock."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会在菜单栏中静默启动，不显示程序坞图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它會在選單列中安靜啟動，不會顯示 Dock 圖像。"
          }
        }
      }
    },
