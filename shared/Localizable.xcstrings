    "While printing, the icon shows the percentage in place of the printer.": {
      "comment": "Windows: Tray page, below “Show the percentage in the icon”",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Během tisku ikona místo tiskárny ukazuje procenta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während des Drucks zeigt das Symbol statt des Druckers den Prozentwert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la impresión, el icono muestra el porcentaje en lugar de la impresora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant l’impression, l’icône affiche le pourcentage à la place de l’imprimante."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyomtatás közben az ikon a nyomtató helyett a százalékot mutatja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la stampa, l'icona mostra la percentuale al posto della stampante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "造形中は、アイコンにプリンターの代わりにパーセンテージが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출력 중에는 아이콘에 프린터 대신 백분율이 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdens het printen toont het pictogram het percentage in plaats van de printer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas drukowania ikona pokazuje procent zamiast drukarki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante a impressão, o ícone mostra a porcentagem no lugar da impressora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время печати значок показывает процент вместо принтера."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Under utskrift visar ikonen procentsatsen i stället för skrivaren."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazdırma sırasında simge, yazıcı yerine yüzdeyi gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час друку значок показує відсоток замість принтера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
