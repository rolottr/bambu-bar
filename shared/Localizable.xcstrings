    "Only Bambu Lab spools with an RFID tag report what’s left.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbývající množství hlásí jen cívky Bambu Lab se štítkem RFID."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Spulen von Bambu Lab mit RFID-Tag melden die Restmenge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo las bobinas Bambu Lab con etiqueta RFID indican lo que queda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les bobines Bambu Lab avec une étiquette RFID indiquent ce qu’il en reste."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak az RFID-címkés Bambu Lab tekercsek jelzik a maradékot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo le bobine Bambu Lab con tag RFID indicano il filamento rimasto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残量がわかるのは、RFIDタグ付きのBambu Labスプールのみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "RFID 태그가 있는 Bambu Lab 스풀만 남은 양을 알려 줍니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen Bambu Lab-spoelen met een RFID-tag geven door wat er nog op zit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko szpule Bambu Lab z tagiem RFID podają pozostałą ilość."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só carretéis Bambu Lab com etiqueta RFID informam quanto resta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток сообщают только катушки Bambu Lab с RFID-меткой."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast Bambu Lab-spolar med RFID-tagg rapporterar hur mycket som finns kvar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca RFID etiketli Bambu Lab makaraları kalan miktarı bildirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок показують лише котушки Bambu Lab із міткою RFID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有带 RFID 标签的 Bambu Lab 料盘才会报告余量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有附 RFID 標籤的 Bambu Lab 料盤會回報剩餘量。"
          }
        }
      }
    },
    "Only in Bambu Bar, for the menu bar, window and widgets. The printer keeps its own name.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen v Bambu Bar, pro řádek nabídek, okno a widgety. Tiskárna si ponechá svůj vlastní název."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur in Bambu Bar, für Menüleiste, Fenster und Widgets. Der Drucker behält seinen eigenen Namen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo en Bambu Bar, para la barra de menús, la ventana y los widgets. La impresora conserva su propio nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement dans Bambu Bar, pour la barre des menus, la fenêtre et les widgets. L’imprimante garde son propre nom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a Bambu Bar alkalmazásban: a menüsorban, az ablakban és a widgeteken. A nyomtató megtartja a saját nevét."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo in Bambu Bar, per la barra dei menu, la finestra e i widget. La stampante mantiene il proprio nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar内（メニューバー、ウインドウ、ウィジェット）でのみ使用されます。プリンター自体の名前は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar의 메뉴 막대, 윈도우 및 위젯에만 적용됩니다. 프린터 자체 이름은 그대로 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen in Bambu Bar, voor de menubalk, het venster en de widgets. De printer houdt zijn eigen naam."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko w Bambu Bar: na pasku menu, w oknie i w widżetach. Drukarka zachowuje własną nazwę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só no Bambu Bar, para a barra de menus, a janela e os widgets. A impressora mantém o próprio nome."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только в Bambu Bar: для строки меню, окна и виджетов. Имя на самом принтере не изменится."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast i Bambu Bar, för menyraden, fönstret och widgetarna. Skrivaren behåller sitt eget namn."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca Bambu Bar'da; menü çubuğu, pencere ve araç takımları için. Yazıcı kendi adını korur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише в Bambu Bar: для смуги меню, вікна й віджетів. Принтер зберігає власну назву."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在 Bambu Bar 中使用，用于菜单栏、窗口和小组件。打印机自身的名称保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅用於 Bambu Bar 的選單列、視窗和小工具。印表機本身的名稱不變。"
          }
        }
      }
    },
    "Only in Bambu Bar, for the tray, window and widgets. The printer keeps its own name.": {
      "comment": "Windows: Printers page, below a printer's name (the Mac's names the menu bar)",
      "localizations": {
        "cs": {
          "stringUnit": {
