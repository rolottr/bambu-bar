    "Bambu Bar follows the printer if its IP address changes.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar tiskárnu najde i po změně její IP adresy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar findet den Drucker auch, wenn sich seine IP-Adresse ändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar sigue a la impresora si cambia su dirección IP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar suit l’imprimante si son adresse IP change."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Bambu Bar követi a nyomtatót, ha megváltozik az IP-címe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar segue la stampante anche se il suo indirizzo IP cambia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリンターのIPアドレスが変わっても、Bambu Barは自動的に追従します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프린터의 IP 주소가 바뀌어도 Bambu Bar가 자동으로 따라갑니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar volgt de printer als het IP-adres verandert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar podąży za drukarką, jeśli zmieni się jej adres IP."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bambu Bar acompanha a impressora se o endereço IP dela mudar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar найдёт принтер, даже если его IP-адрес изменится."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar följer skrivaren om dess IP-adress ändras."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazıcının IP adresi değişirse Bambu Bar onu takip eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar знайде принтер, навіть якщо його IP-адреса зміниться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打印机的 IP 地址变化时，Bambu Bar 会自动跟随。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "印表機的 IP 位址變更時，Bambu Bar 會自動跟上。"
          }
        }
      }
    },
    "Bambu Bar hasn't found your printer yet. Type its IP address under “Enter address manually”.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar vaši tiskárnu zatím nenašel. Zadejte její IP adresu v části „Zadat adresu ručně“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar hat Ihren Drucker noch nicht gefunden. Geben Sie seine IP-Adresse unter „Adresse manuell eingeben“ ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar aún no ha encontrado la impresora. Escriba su dirección IP en «Introducir dirección manualmente»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar n’a pas encore trouvé votre imprimante. Saisissez son adresse IP sous « Saisir l’adresse manuellement »."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Bambu Bar még nem találta meg a nyomtatót. Írd be az IP-címét a „Cím megadása kézzel” résznél."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar non ha ancora trovato la stampante. Digita il suo indirizzo IP in “Inserisci indirizzo manualmente”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Barはまだプリンターを見つけていません。「アドレスを手動で入力」にIPアドレスを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar가 아직 프린터를 찾지 못했습니다. “주소 직접 입력”에 IP 주소를 입력하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar heeft uw printer nog niet gevonden. Typ het IP-adres onder “Voer adres handmatig in”."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar nie znalazł jeszcze drukarki. Wpisz jej adres IP w sekcji „Wpisz adres ręcznie”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bambu Bar ainda não encontrou sua impressora. Digite o endereço IP dela em “Inserir endereço manualmente”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar ещё не нашёл ваш принтер. Введите его IP-адрес в разделе «Ввести адрес вручную»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar har inte hittat din skrivare än. Skriv in dess IP-adress under ”Ange adress manuellt”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar yazıcını henüz bulamadı. IP adresini “Adresi elle gir” bölümüne yaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar ще не знайшов ваш принтер. Введіть його IP-адресу в розділі «Ввести адресу вручну»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar 尚未找到您的打印机。请在“手动输入地址”下输入其 IP 地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar 尚未找到您的印表機。請在「手動輸入位址」中輸入其 IP 位址。"
          }
        }
      }
    },
    "Bambu Bar is free to use. Activate a supporter license to enable automatic updates and receive the Hero Supporter badge.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar je zdarma. Aktivací podporovatelské licence zapnete automatické aktualizace a získáte odznak Hero Supporter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar ist kostenlos nutzbar. Aktivieren Sie eine Unterstützerlizenz, um automatische Updates freizuschalten und das Abzeichen „Hero Supporter“ zu erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar es gratis. Active una licencia de apoyo para habilitar las actualizaciones automáticas y recibir la insignia Hero Supporter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar est gratuit. Activez une licence de soutien pour bénéficier des mises à jour automatiques et obtenir le badge Hero Supporter."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Bambu Bar ingyenesen használható. Aktiválj egy támogatói licencet, hogy bekapcsold az automatikus frissítéseket, és megkapd a Hero Supporter jelvényt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar è gratuito. Attiva una licenza di supporto per abilitare gli aggiornamenti automatici e ricevere il badge Hero Supporter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Barは無料で使えます。サポーターライセンスを認証すると、自動アップデートが有効になり、Hero Supporterバッジを受け取れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar는 무료로 사용할 수 있습니다. 후원자 라이선스를 활성화하면 자동 업데이트를 사용할 수 있고 Hero Supporter 배지를 받습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar is gratis te gebruiken. Activeer een supporterlicentie om automatische updates in te schakelen en de badge Hero Supporter te krijgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar jest darmowy. Aktywuj licencję wspierającego, aby włączyć automatyczne uaktualnienia i otrzymać odznakę Hero Supporter."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bambu Bar é gratuito. Ative uma licença de apoio para liberar as atualizações automáticas e receber o selo Hero Supporter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar можно использовать бесплатно. Активируйте лицензию сторонника, чтобы включить автоматические обновления и получить значок Hero Supporter."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar är gratis att använda. Aktivera en stödlicens för att slå på automatiska uppdateringar och få märket Hero Supporter."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar'ı ücretsiz kullanabilirsin. Otomatik güncellemeleri açmak ve Hero Supporter rozetini almak için bir destekçi lisansı etkinleştir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar — безплатна програма. Активуйте ліцензію прихильника, щоб увімкнути автоматичні оновлення й отримати значок Hero Supporter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar 可免费使用。激活支持者许可证即可启用自动更新，并获得 Hero Supporter 徽章。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar 可以免費使用。啟用支持者授權即可開啟自動更新，並獲得 Hero Supporter 徽章。"
          }
        }
      }
    },
    "Bambu Bar is turned off in Startup apps, so it won't open at sign-in.": {
      "comment": "Windows: Settings page, when Windows' Startup apps list has the app turned off",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar je vypnutý v Aplikacích po spuštění, takže se po přihlášení neotevře."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar ist unter „Autostart-Apps“ deaktiviert und öffnet sich daher nicht bei der Anmeldung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar está desactivado en Aplicaciones de arranque, así que no se abrirá al iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar est désactivé dans Applications de démarrage ; il ne s’ouvrira donc pas à la connexion."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Bambu Bar ki van kapcsolva az Indítási alkalmazások között, ezért bejelentkezéskor nem nyílik meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar è disattivato in App di avvio, quindi non si aprirà all'accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Barはスタートアップアプリでオフになっているため、サインイン時に開きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 프로그램에서 Bambu Bar가 꺼져 있어 로그인할 때 열리지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar staat uit in Opstart-apps en wordt daarom niet geopend bij het aanmelden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar jest wyłączony w Aplikacjach autostartu, więc nie otworzy się po zalogowaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bambu Bar está desativado em Aplicativos de inicialização, por isso não abrirá ao entrar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar отключён в разделе «Автозагрузка», поэтому не откроется при входе."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar är avstängt i Autostartappar och öppnas därför inte vid inloggning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar, Başlangıç uygulamalarında kapalı olduğu için oturum açıldığında açılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar вимкнено в розділі «Автозавантаження», тож програма не відкриватиметься під час входу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar 已在“启动应用”中关闭，因此登录时不会打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar 已在「啟動應用程式」中關閉，因此登入時不會開啟。"
          }
        }
      }
    },
