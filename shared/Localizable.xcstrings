    "Nothing answered at that address. Check the IP address on the printer's screen (Settings → Network).": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na této adrese nic neodpovědělo. Zkontrolujte IP adresu na obrazovce tiskárny (Nastavení → Síť)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter dieser Adresse antwortet nichts. Prüfen Sie die IP-Adresse auf dem Druckerdisplay (Einstellungen → Netzwerk)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hubo respuesta en esa dirección. Compruebe la dirección IP en la pantalla de la impresora (Configuración → Red)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’a répondu à cette adresse. Vérifiez l’adresse IP sur l’écran de l’imprimante (Paramètres → Réseau)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezen a címen semmi sem válaszolt. Ellenőrizd az IP-címet a nyomtató képernyőjén (Beállítások → Hálózat)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna risposta da quell'indirizzo. Controlla l'indirizzo IP sullo schermo della stampante (Impostazioni → Rete)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのアドレスから応答がありません。プリンターの画面（設定 → ネットワーク）でIPアドレスを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 주소에서 응답이 없습니다. 프린터 화면(설정 → 네트워크)에서 IP 주소를 확인하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen antwoord op dat adres. Controleer het IP-adres op het scherm van de printer (Instellingen → Netwerk)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie odpowiedziało pod tym adresem. Sprawdź adres IP na ekranie drukarki (Ustawienia → Sieć)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada respondeu nesse endereço. Confira o endereço IP na tela da impressora (Configurações → Rede)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По этому адресу никто не ответил. Проверьте IP-адрес на экране принтера (Настройки → Сеть)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget svarade på den adressen. Kontrollera IP-adressen på skrivarens skärm (Inställningar → Nätverk)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adresten yanıt gelmedi. IP adresini yazıcının ekranında kontrol et (Ayarlar → Ağ)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За цією адресою ніхто не відповів. Перевірте IP-адресу на екрані принтера (Налаштування → Мережа)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该地址没有响应。请在打印机屏幕的“设置 → 网络”中查看 IP 地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
