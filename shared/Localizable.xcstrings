          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast i Bambu Bar, för meddelandefältet, fönstret och widgetarna. Skrivaren behåller sitt eget namn."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca Bambu Bar'da; bildirim alanı, pencere ve araç takımları için. Yazıcı kendi adını korur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише в Bambu Bar: для області сповіщень, вікна й віджетів. Принтер зберігає власну назву."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在 Bambu Bar 中使用，用于通知区域、窗口和小组件。打印机自身的名称保持不变。"
          }
        },
        "zh-Hant": {
