            "value": "Dégagez le plateau pour imprimer de nouveau"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ürítsd ki a tálcát az újabb nyomtatáshoz"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera il piatto per stampare di nuovo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の造形の前にプレートを空にしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 출력하려면 플레이트를 비우십시오"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak de plaat leeg om opnieuw te printen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opróżnij płytę, aby drukować ponownie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Libere a placa para imprimir de novo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Освободите пластину для новой печати"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Töm plattan för att skriva ut igen"
