    },
    "You have %@. Download the new version from its GitHub release page, then replace the app in your Applications folder.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Máte verzi %@. Stáhněte novou verzi ze stránky vydání na GitHubu a pak nahraďte aplikaci ve složce Aplikace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben %@. Laden Sie die neue Version von ihrer Release-Seite auf GitHub und ersetzen Sie dann die App im Ordner „Programme“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene la versión %@. Descargue la nueva versión desde su página en GitHub y sustituya la app en la carpeta Aplicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez la version %@. Téléchargez la nouvelle version depuis sa page de publication sur GitHub, puis remplacez l’app dans votre dossier Applications."
