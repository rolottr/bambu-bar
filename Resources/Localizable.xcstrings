    "Leave empty to follow the menu bar printer.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponechte prázdné, aby widget sledoval tiskárnu z řádku nabídek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lassen, um dem Drucker der Menüleiste zu folgen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjelo vacío para seguir a la impresora de la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide pour suivre l’imprimante de la barre des menus."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hagyd üresen, ha a menüsor nyomtatóját kövesse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia vuoto per seguire la stampante della barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空のままにすると、メニューバーのプリンターに従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비워 두면 메뉴 막대의 프린터를 따릅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat leeg om de printer in de menubalk te volgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostaw puste, aby pokazywać drukarkę z paska menu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe vazio para seguir a impressora da barra de menus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте пустым, чтобы показывать принтер из строки меню."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lämna tomt för att följa skrivaren i menyraden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menü çubuğundaki yazıcıyı takip etmek için boş bırak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залиште порожнім, щоб показувати принтер зі смуги меню."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留空则跟随菜单栏中的打印机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留空即跟隨選單列中的印表機。"
          }
        }
      }
    },
