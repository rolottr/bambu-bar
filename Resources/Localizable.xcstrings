    "You have %@. Download it from GitHub, then replace the app in your Applications folder.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Máte verzi %@. Stáhněte novou z GitHubu a pak nahraďte aplikaci ve složce Aplikace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben %@. Laden Sie die neue Version von GitHub und ersetzen Sie dann die App im Ordner „Programme“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene la versión %@. Descárguela de GitHub y sustituya la app en la carpeta Aplicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez la version %@. Téléchargez-la depuis GitHub, puis remplacez l’app dans votre dossier Applications."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelenlegi verzió: %@. Töltsd le a GitHubról, majd cseréld le az alkalmazást az Alkalmazások mappában."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai la versione %@. Scaricala da GitHub, poi sostituisci l'app nella cartella Applicazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のバージョンは%@です。GitHubからダウンロードし、「アプリケーション」フォルダ内のアプリを置き換えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 버전은 %@입니다. GitHub에서 다운로드한 다음 응용 프로그램 폴더의 앱을 교체하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U hebt %@. Download de nieuwe versie van GitHub en vervang de app in uw map Programma's."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
