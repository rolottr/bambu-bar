            "value": "У вас версія %@. Завантажте нову з GitHub і замініть програму в папці «Програми»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前版本为 %@。请从 GitHub 下载新版本，然后替换“应用程序”文件夹中的 App。"
