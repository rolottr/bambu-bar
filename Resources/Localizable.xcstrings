        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас версия %@. Загрузите новую версию со страницы выпуска на GitHub и замените приложение в папке «Программы»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har %@. Hämta den nya versionen från dess releasesida på GitHub och ersätt sedan appen i mappen Program."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüklü sürüm: %@. Yeni sürümü GitHub'daki sürüm sayfasından indir, ardından Uygulamalar klasöründeki uygulamayı değiştir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас версія %@. Завантажте нову версію зі сторінки випуску на GitHub і замініть програму в папці «Програми»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前版本为 %@。请从 GitHub 的版本发布页面下载新版本，然后替换“应用程序”文件夹中的 App。"
          }
