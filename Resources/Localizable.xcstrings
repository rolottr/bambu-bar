          }
        }
      }
    },
    "The printer models were built for this project in Blender. They are visual approximations, not manufacturer CAD.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Modely tiskáren byly pro tento projekt vytvořeny v Blenderu. Jde o vizuální přiblížení, ne o CAD data výrobce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Druckermodelle wurden für dieses Projekt in Blender erstellt. Sie sind visuelle Annäherungen, keine CAD-Daten des Herstellers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos de las impresoras se crearon en Blender para este proyecto. Son aproximaciones visuales, no CAD del fabricante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles d’imprimante ont été créés pour ce projet dans Blender. Ce sont des approximations visuelles, pas des CAO du fabricant."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nyomtatómodellek ehhez a projekthez készültek Blenderben. Vizuális közelítések, nem a gyártó CAD-modelljei."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I modelli delle stampanti sono stati realizzati in Blender per questo progetto. Sono approssimazioni visive, non CAD del produttore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリンターのモデルは、このプロジェクトのためにBlenderで作成されました。外観を再現したもので、メーカーのCADデータではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프린터 모델은 이 프로젝트를 위해 Blender로 제작되었습니다. 제조사 CAD가 아닌 시각적 근사치입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De printermodellen zijn voor dit project in Blender gemaakt. Het zijn visuele benaderingen, geen CAD van de fabrikant."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Modele drukarek zostały wykonane w Blenderze na potrzeby tego projektu. To wizualne przybliżenia, a nie modele CAD producenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos das impressoras foram criados para este projeto no Blender. São aproximações visuais, não o CAD do fabricante."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модели принтеров созданы для этого проекта в Blender. Это визуальные приближения, а не CAD-модели производителя."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivarmodellerna byggdes för det här projektet i Blender. De är visuella approximationer, inte tillverkarens CAD."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazıcı modelleri bu proje için Blender'da oluşturuldu. Bunlar üreticinin CAD verileri değil, görsel yaklaşık modellerdir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Моделі принтерів створено для цього проєкту в Blender. Це візуальні наближення, а не CAD-моделі виробника."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打印机模型是为本项目在 Blender 中制作的，仅为外观近似，并非制造商的 CAD 模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "印表機模型是為此專案以 Blender 製作，僅為外觀近似，並非製造商的 CAD 模型。"
          }
        }
      }
    },
    "The printer only accepts commands in Developer Mode.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiskárna přijímá příkazy jen v Režimu vývojáře."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Drucker akzeptiert Befehle nur im Entwicklermodus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La impresora solo acepta comandos en Modo desarrollador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’imprimante n’accepte les commandes qu’en mode Développeur."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nyomtató csak Fejlesztői módban fogad el parancsokat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stampante accetta comandi solo in Modalità sviluppatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリンターは開発者モードでのみコマンドを受け付けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프린터는 개발자 모드에서만 명령을 받습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De printer accepteert alleen opdrachten in Ontwikkelaarsmodus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drukarka przyjmuje polecenia tylko w trybie programisty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A impressora só aceita comandos no Modo de desenvolvedor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принтер принимает команды только в режиме разработчика."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivaren tar bara emot kommandon i Utvecklarläge."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazıcı komutları yalnızca Geliştirici Modu'nda kabul eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Принтер приймає команди лише в режимі розробника."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打印机仅在开发者模式下接受命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "印表機只有在「開發者模式」下才接受指令。"
          }
        }
      }
    },
    "The printer only accepts pause, stop and speed changes from apps in **LAN Only** mode with **Developer Mode** on (printer screen → Settings → Network). Status and the chamber light work either way.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiskárna přijímá pozastavení, zastavení a změny rychlosti z aplikací jen v režimu **Pouze LAN** se zapnutým **Režimem vývojáře** (obrazovka tiskárny → Nastavení → Síť). Stav a osvětlení komory fungují v obou případech."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Drucker akzeptiert Pausieren, Stoppen und Geschwindigkeitsänderungen von Apps nur im **Nur-LAN**-Modus mit aktiviertem **Entwicklermodus** (Druckerdisplay → Einstellungen → Netzwerk). Status und Kammerbeleuchtung funktionieren immer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La impresora solo acepta pausar, detener y cambios de velocidad desde apps en modo **Solo LAN** con el **Modo desarrollador** activado (pantalla de la impresora → Configuración → Red). El estado y la luz de la cámara funcionan en cualquier modo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’imprimante n’accepte la pause, l’arrêt et les changements de vitesse venant d’apps qu’en **mode LAN** avec le **mode Développeur** activé (écran de l’imprimante → Paramètres → Réseau). L’état et la lumière de la chambre fonctionnent dans tous les cas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nyomtató csak akkor fogad el szüneteltetést, leállítást és sebességváltást alkalmazásokból, ha **LAN mód** van beállítva, és a **Fejlesztői mód** be van kapcsolva (nyomtató képernyője → Beállítások → Hálózat). Az állapot és a kamravilágítás mindkét esetben működik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stampante accetta pausa, interruzione e cambi di velocità dalle app solo in modalità **Solo LAN** con la **Modalità sviluppatore** attiva (schermo della stampante → Impostazioni → Rete). Stato e luce della camera funzionano in ogni caso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリンターがアプリからの一時停止、中止、速度変更を受け付けるのは、**LAN専用**モードで**開発者モード**がオンの場合のみです（プリンター画面 → 設定 → ネットワーク）。ステータスとチャンバー照明はどちらのモードでも使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프린터는 **LAN 전용** 모드에서 **개발자 모드**가 켜져 있을 때만 앱의 일시정지, 중지, 속도 변경 명령을 받습니다(프린터 화면 → 설정 → 네트워크). 상태와 챔버 조명은 어느 경우에나 작동합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De printer accepteert pauzeren, stoppen en snelheidswijzigingen van apps alleen in de modus **Alleen LAN** met **Ontwikkelaarsmodus** aan (printerscherm → Instellingen → Netwerk). Status en kamerverlichting werken altijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drukarka przyjmuje wstrzymywanie, zatrzymywanie i zmiany prędkości z aplikacji tylko w trybie **Tylko LAN** z włączonym **trybem programisty** (ekran drukarki → Ustawienia → Sieć). Stan i oświetlenie komory działają w obu przypadkach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A impressora só aceita pausar, parar e mudar a velocidade por apps no modo **Somente LAN** com o **Modo de desenvolvedor** ativado (tela da impressora → Configurações → Rede). O estado e a luz da câmara funcionam de qualquer forma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принтер принимает от приложений паузу, остановку и смену скорости только в режиме **Только локальная сеть** с включённым **режимом разработчика** (экран принтера → Настройки → Сеть). Статус и подсветка камеры работают в любом случае."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivaren tar bara emot paus, stopp och hastighetsändringar från appar i läget **Endast LAN** med **Utvecklarläge** påslaget (skrivarens skärm → Inställningar → Nätverk). Status och kammarlampan fungerar i båda fallen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazıcı, uygulamalardan gelen duraklatma, durdurma ve hız değişikliklerini yalnızca **Geliştirici Modu** açıkken **Yalnızca LAN** modunda kabul eder (yazıcı ekranı → Ayarlar → Ağ). Durum ve oda ışığı her iki durumda da çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Паузу, зупинку й зміну швидкості від програм принтер приймає лише в режимі **Лише LAN** з увімкненим **Режимом розробника** (екран принтера → Налаштування → Мережа). Стан і освітлення камери працюють у будь-якому разі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在**仅局域网**模式下并开启**开发者模式**时（打印机屏幕 → 设置 → 网络），打印机才接受来自 App 的暂停、停止和调速操作。状态和腔体照明灯在任何模式下都可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "印表機只有在 **僅區域網路** 模式下並開啟 **開發者模式** 時，才接受 App 發出的暫停、停止和變更速度指令（印表機螢幕 → 設定 → 網路）。狀態和腔體照明在任何模式下皆可使用。"
          }
        }
      }
    },
    "The printer refused the command.": {
      "localizations": {
