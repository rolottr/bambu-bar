          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프린터의 TLS 인증서를 확인할 수 없습니다: %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het TLS-certificaat van de printer kan niet worden geverifieerd: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zweryfikować certyfikatu TLS drukarki: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar o certificado TLS da impressora: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить TLS-сертификат принтера: %@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivarens TLS-certifikat kunde inte verifieras: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazıcının TLS sertifikası doğrulanamadı: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося перевірити TLS-сертифікат принтера: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证打印机的 TLS 证书：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證印表機的 TLS 憑證：%@"
          }
        }
      }
    },
    "Their access codes are saved there, so they can all be added at once.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jejich přístupové kódy jsou tam uložené, takže je lze přidat všechny najednou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Zugangscodes sind dort gespeichert, daher können alle auf einmal hinzugefügt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus códigos de acceso están guardados ahí, así que se pueden añadir todas a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leurs codes d’accès y sont enregistrés, elles peuvent donc toutes être ajoutées en une fois."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hozzáférési kódjaik ott vannak mentve, így egyszerre hozzáadhatod mindet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I loro codici di accesso sono salvati lì, quindi puoi aggiungerle tutte in una volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そこにアクセスコードが保存されているため、まとめて追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그곳에 액세스 코드가 저장되어 있으므로 한 번에 모두 추가할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hun toegangscodes zijn daar bewaard, dus ze kunnen allemaal tegelijk worden toegevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kody dostępu są tam zapisane, więc można je dodać wszystkie naraz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os códigos de acesso delas estão salvos lá, então todas podem ser adicionadas de uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Там сохранены их коды доступа, поэтому все принтеры можно добавить сразу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Deras åtkomstkoder är sparade där, så alla kan läggas till på en gång."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişim kodları orada kayıtlı olduğundan hepsi tek seferde eklenebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Там збережено їхні коди доступу, тож усі принтери можна додати одразу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其中保存了这些打印机的访问码，因此可以一次性全部添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其中已儲存這些印表機的存取碼，因此可以一次全部加入。"
          }
        }
      }
    },
