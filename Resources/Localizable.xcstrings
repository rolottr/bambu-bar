        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy, max. %lld °C"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno, fino a %lld °C"
          }
        },
        "ja": {
