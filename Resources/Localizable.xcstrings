        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U hebt %@. Download de nieuwe versie van de releasepagina op GitHub en vervang de app in uw map Programma's."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz wersję %@. Pobierz nową wersję ze strony wydania w serwisie GitHub, a następnie zastąp aplikację w folderze Aplikacje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua versão é a %@. Baixe a nova versão na página dela no GitHub e substitua o app na pasta Aplicativos."
