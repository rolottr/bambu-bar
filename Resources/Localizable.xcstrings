    },
    "Your Bambu Lab printer, one click away in the menu bar.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše tiskárna Bambu Lab na jedno kliknutí v řádku nabídek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Drucker von Bambu Lab, nur einen Klick entfernt in der Menüleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su impresora Bambu Lab, a un clic en la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre imprimante Bambu Lab, à un clic dans la barre des menus."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Lab nyomtatód egy kattintásra a menüsorban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua stampante Bambu Lab, a un clic dalla barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Labプリンターを、メニューバーからワンクリックで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대에서 클릭 한 번으로 만나는 Bambu Lab 프린터."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw Bambu Lab-printer, met één klik bereikbaar in de menubalk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja drukarka Bambu Lab o jedno kliknięcie, na pasku menu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua impressora Bambu Lab a um clique, na barra de menus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш принтер Bambu Lab — в один клик из строки меню."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Bambu Lab-skrivare, ett klick bort i menyraden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Lab yazıcın, menü çubuğunda bir tık uzağında."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш принтер Bambu Lab — за один клік у смузі меню."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在菜单栏中一键查看您的 Bambu Lab 打印机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在選單列按一下，即可查看您的 Bambu Lab 印表機。"
          }
        }
      }
    },
    "Your printer's progress, temperatures and filament, one click away in the menu bar. Bambu Bar talks to the printer directly over your network: no account, no cloud.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Průběh, teploty a filament vaší tiskárny na jedno kliknutí v řádku nabídek. Bambu Bar komunikuje s tiskárnou přímo přes vaši síť: žádný účet, žádný cloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortschritt, Temperaturen und Filament Ihres Druckers, nur einen Klick entfernt in der Menüleiste. Bambu Bar kommuniziert direkt über Ihr Netzwerk mit dem Drucker: kein Konto, keine Cloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El progreso, las temperaturas y el filamento de su impresora, a un clic en la barra de menús. Bambu Bar se comunica directamente con la impresora a través de su red: sin cuenta y sin nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La progression, les températures et le filament de votre imprimante, à un clic dans la barre des menus. Bambu Bar communique directement avec l’imprimante via votre réseau : pas de compte, pas de cloud."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyomtatód előrehaladása, hőmérsékletei és filamentje egy kattintásra a menüsorban. A Bambu Bar közvetlenül a hálózaton keresztül kommunikál a nyomtatóval: nincs fiók, nincs felhő."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avanzamento, temperature e filamento della stampante, a un clic dalla barra dei menu. Bambu Bar comunica direttamente con la stampante sulla tua rete: nessun account, nessun cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリンターの進捗、温度、フィラメントを、メニューバーからワンクリックで確認。Bambu Barはネットワーク経由でプリンターと直接通信します。アカウントもクラウドも不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프린터의 진행률, 온도, 필라멘트를 메뉴 막대에서 클릭 한 번으로 확인하십시오. Bambu Bar는 네트워크를 통해 프린터와 직접 통신합니다. 계정도, 클라우드도 필요 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De voortgang, temperaturen en het filament van uw printer, met één klik bereikbaar in de menubalk. Bambu Bar praat rechtstreeks met de printer via uw netwerk: geen account, geen cloud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Postęp, temperatury i filament Twojej drukarki o jedno kliknięcie, na pasku menu. Bambu Bar komunikuje się z drukarką bezpośrednio przez sieć: bez konta, bez chmury."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O progresso, as temperaturas e o filamento da sua impressora a um clique, na barra de menus. O Bambu Bar fala direto com a impressora pela sua rede: sem conta, sem nuvem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогресс, температуры и филамент вашего принтера — в один клик из строки меню. Bambu Bar связывается с принтером напрямую по вашей сети: без учётной записи и облака."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din skrivares förlopp, temperaturer och filament, ett klick bort i menyraden. Bambu Bar pratar direkt med skrivaren via ditt nätverk: inget konto, inget moln."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazıcının ilerlemesi, sıcaklıkları ve filamenti menü çubuğunda bir tık uzağında. Bambu Bar yazıcıyla doğrudan ağın üzerinden konuşur: hesap yok, bulut yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогрес, температури й філамент вашого принтера — за один клік у смузі меню. Bambu Bar спілкується з принтером напряму через вашу мережу: без облікового запису й хмари."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在菜单栏中一键查看打印机的进度、温度和耗材。Bambu Bar 通过您的网络直接与打印机通信：无需账户，不经云端。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在選單列按一下，即可查看印表機的進度、溫度和線材。Bambu Bar 直接透過您的網路與印表機通訊：無須帳號，不經雲端。"
          }
        }
      }
    },
    "Your printers on the desktop and in Notification Center, in three sizes.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše tiskárny na ploše a v Oznamovacím centru ve třech velikostech."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Drucker auf dem Schreibtisch und in der Mitteilungszentrale, in drei Größen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus impresoras en el escritorio y en el Centro de notificaciones, en tres tamaños."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos imprimantes sur le bureau et dans le Centre de notifications, en trois tailles."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyomtatóid az íróasztalon és az Értesítési központban, három méretben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue stampanti sulla scrivania e nel Centro Notifiche, in tre dimensioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップと通知センターに、プリンターを3つのサイズで表示。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데스크탑과 알림 센터에 세 가지 크기로 표시되는 프린터."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw printers op het bureaublad en in het Berichtencentrum, in drie formaten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje drukarki na biurku i w Centrum powiadomień, w trzech rozmiarach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas impressoras na mesa e na Central de Notificações, em três tamanhos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши принтеры на рабочем столе и в Центре уведомлений, в трёх размерах."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina skrivare på skrivbordet och i Notiscenter, i tre storlekar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazıcıların masaüstünde ve Bildirim Merkezi'nde, üç boyutta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші принтери на робочому столі й у Центрі сповіщень, у трьох розмірах."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在桌面和通知中心查看您的打印机，提供三种尺寸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在桌面和「通知中心」查看您的印表機，提供三種尺寸。"
          }
        }
      }
    },
    "You’re up to date": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Máte aktuální verzi"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie verwenden die neueste Version"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene la última versión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes à jour"
          }
        },
        "hu": {
          "stringUnit": {
