    "%@ finished in %@. It's ready to take off the plate.": {
      "comment": "Job name, then how long it took",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ – hotovo za %@. Výtisk můžete sejmout z podložky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ war nach %@ fertig. Das Teil kann von der Druckplatte genommen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ finished in %2$@. It's ready to take off the plate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ terminó en %2$@. Ya se puede retirar de la placa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ terminé en %@. La pièce peut être retirée du plateau."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ elkészült, %2$@ alatt. Levehető a tálcáról."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: stampa completata in %@. Puoi rimuoverla dal piatto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が%2$@で完了しました。プレートから取り外せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 출력이 완료되었습니다(%@ 소요). 이제 플레이트에서 떼어 낼 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ voltooid in %@. Klaar om van de plaat te halen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydrukowano %1$@ w %2$@. Wydruk można zdjąć z płyty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ terminou em %@. Já pode ser retirado da placa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Печать «%@» завершена за %@. Модель можно снять с пластины."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ blev färdig på %@. Den är redo att tas av plattan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ sürede bitti. Tabladan alınabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Друк «%@» завершено за %@. Можна знімати з пластини."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已完成，用时 %@。可以从打印板上取下了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已完成，耗時 %@。可以從列印板上取下了。"
          }
        }
      }
    },
