    "Check the access code on the printer's screen (Settings → Network) and enter it again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolujte přístupový kód na obrazovce tiskárny (Nastavení → Síť) a zadejte ho znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie den Zugangscode auf dem Druckerdisplay (Einstellungen → Netzwerk) und geben Sie ihn erneut ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compruebe el código de acceso en la pantalla de la impresora (Configuración → Red) e introdúzcalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez le code d’accès sur l’écran de l’imprimante (Paramètres → Réseau) et saisissez-le de nouveau."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellenőrizd a hozzáférési kódot a nyomtató képernyőjén (Beállítások → Hálózat), és add meg újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla il codice di accesso sullo schermo della stampante (Impostazioni → Rete) e inseriscilo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリンターの画面（設定 → ネットワーク）でアクセスコードを確認し、もう一度入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프린터 화면(설정 → 네트워크)에서 액세스 코드를 확인하고 다시 입력하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer de toegangscode op het scherm van de printer (Instellingen → Netwerk) en voer deze opnieuw in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź kod dostępu na ekranie drukarki (Ustawienia → Sieć) i wpisz go ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira o código de acesso na tela da impressora (Configurações → Rede) e insira-o novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте код доступа на экране принтера (Настройки → Сеть) и введите его снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera åtkomstkoden på skrivarens skärm (Inställningar → Nätverk) och ange den igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişim kodunu yazıcının ekranında kontrol et (Ayarlar → Ağ) ve yeniden gir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте код доступу на екрані принтера (Налаштування → Мережа) і введіть його знову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在打印机屏幕的“设置 → 网络”中查看访问码，然后重新输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在印表機螢幕上（設定 → 網路）確認存取碼，然後重新輸入。"
          }
        }
      }
    },
