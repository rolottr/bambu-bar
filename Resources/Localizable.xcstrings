          "stringUnit": {
            "state": "translated",
            "value": "A jelenlegi verzió: %@. Töltsd le az új verziót a GitHub kiadási oldaláról, majd cseréld le az alkalmazást az Alkalmazások mappában."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai la versione %@. Scarica la nuova versione dalla sua pagina release su GitHub, poi sostituisci l'app nella cartella Applicazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のバージョンは%@です。GitHubのリリースページから新しいバージョンをダウンロードし、「アプリケーション」フォルダ内のアプリを置き換えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 버전은 %@입니다. GitHub 릴리스 페이지에서 새 버전을 다운로드한 다음 응용 프로그램 폴더의 앱을 교체하십시오."
