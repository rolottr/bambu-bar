    "Print progress, time left, temperatures and filament. Edit the widget to choose the printer.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Průběh tisku, zbývající čas, teploty a filament. Tiskárnu vyberete úpravou widgetu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Druckfortschritt, Restzeit, Temperaturen und Filament. Bearbeiten Sie das Widget, um den Drucker zu wählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Progreso, tiempo restante, temperaturas y filamento. Edite el widget para elegir la impresora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Progression de l’impression, temps restant, températures et filament. Modifiez le widget pour choisir l’imprimante."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyomtatási előrehaladás, hátralévő idő, hőmérsékletek és filament. A nyomtató kiválasztásához szerkeszd a widgetet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avanzamento della stampa, tempo rimanente, temperature e filamento. Modifica il widget per scegliere la stampante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "造形の進捗、残り時間、温度、フィラメント。ウィジェットを編集してプリンターを選択できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출력 진행률, 남은 시간, 온도, 필라멘트. 위젯을 편집하여 프린터를 선택하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Printvoortgang, resterende tijd, temperaturen en filament. Wijzig de widget om de printer te kiezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Postęp druku, pozostały czas, temperatury i filament. Edytuj widżet, aby wybrać drukarkę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Progresso da impressão, tempo restante, temperaturas e filamento. Edite o widget para escolher a impressora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогресс печати, оставшееся время, температуры и филамент. Чтобы выбрать принтер, измените виджет."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utskriftsförlopp, återstående tid, temperaturer och filament. Redigera widgeten för att välja skrivare."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baskı ilerlemesi, kalan süre, sıcaklıklar ve filament. Yazıcıyı seçmek için widget'ı düzenle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогрес друку, залишок часу, температури й філамент. Щоб вибрати принтер, відредагуйте віджет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打印进度、剩余时间、温度和耗材。编辑小组件以选择打印机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "列印進度、剩餘時間、溫度和線材。編輯小工具即可選擇印表機。"
          }
        }
      }
    },
