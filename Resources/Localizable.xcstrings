    "This Mac isn't on a network.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento Mac není připojen k síti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac ist mit keinem Netzwerk verbunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no está conectado a ninguna red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac n’est connecté à aucun réseau."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a Mac nem csatlakozik hálózathoz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac non è connesso a una rete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacはネットワークに接続されていません。"
          }
