    },
    "The printer stopped answering.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiskárna přestala odpovídat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Drucker antwortet nicht mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La impresora dejó de responder."
          }
        },
        "fr": {
