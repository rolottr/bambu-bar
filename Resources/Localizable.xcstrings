    "Turn on LAN Only and Developer Mode on the printer to control prints from Bambu Bar.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li ovládat tisky z Bambu Bar, zapněte na tiskárně Pouze LAN a Režim vývojáře."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie Nur-LAN und den Entwicklermodus am Drucker, um Drucke über Bambu Bar zu steuern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Active Solo LAN y el Modo desarrollador en la impresora para controlar las impresiones desde Bambu Bar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez le mode LAN et le mode Développeur sur l’imprimante pour contrôler les impressions depuis Bambu Bar."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nyomtatások Bambu Bar alkalmazásból való vezérléséhez kapcsold be a LAN módot és a Fejlesztői módot a nyomtatón."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Solo LAN e Modalità sviluppatore sulla stampante per controllare le stampe da Bambu Bar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Barから造形を操作するには、プリンターでLAN専用モードと開発者モードをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar에서 출력을 제어하려면 프린터에서 LAN 전용 및 개발자 모드를 켜십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet Alleen LAN en Ontwikkelaarsmodus aan op de printer om prints vanuit Bambu Bar te bedienen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz tryb Tylko LAN i tryb programisty na drukarce, aby sterować wydrukami z Bambu Bar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative Somente LAN e o Modo de desenvolvedor na impressora para controlar impressões pelo Bambu Bar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы управлять печатью из Bambu Bar, включите на принтере режим «Только локальная сеть» и режим разработчика."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Endast LAN och Utvecklarläge på skrivaren för att styra utskrifter från Bambu Bar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baskıları Bambu Bar'dan kontrol etmek için yazıcıda Yalnızca LAN ve Geliştirici Modu'nu aç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб керувати друком із Bambu Bar, увімкніть на принтері «Лише LAN» і режим розробника."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在打印机上打开“仅局域网”和“开发者模式”，即可通过 Bambu Bar 控制打印。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在印表機上開啟「僅區域網路」和「開發者模式」，即可從 Bambu Bar 控制列印。"
          }
        }
      }
    },
