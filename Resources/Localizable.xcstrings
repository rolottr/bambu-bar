          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De printer is niet bereikbaar op het netwerk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drukarka jest nieosiągalna w sieci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A impressora não está acessível na rede."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принтер недоступен в сети."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivaren kan inte nås i nätverket."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
