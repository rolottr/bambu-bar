    "Bambu Bar can't reach your network": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar se nemůže připojit k vaší síti"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar kann Ihr Netzwerk nicht erreichen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar no puede acceder a la red"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar ne peut pas accéder à votre réseau"
