    "Bambu Lab, Bambu Studio and P2S are trademarks of Bambu Lab. Bambu Bar is an independent project, not affiliated with or endorsed by Bambu Lab.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Lab, Bambu Studio a P2S jsou ochranné známky společnosti Bambu Lab. Bambu Bar je nezávislý projekt, který není spojen se společností Bambu Lab ani jí podporován."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Lab, Bambu Studio und P2S sind Marken von Bambu Lab. Bambu Bar ist ein unabhängiges Projekt, weder mit Bambu Lab verbunden noch von Bambu Lab unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Lab, Bambu Studio y P2S son marcas comerciales de Bambu Lab. Bambu Bar es un proyecto independiente, sin afiliación ni respaldo de Bambu Lab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Lab, Bambu Studio et P2S sont des marques de Bambu Lab. Bambu Bar est un projet indépendant, ni affilié à Bambu Lab ni approuvé par Bambu Lab."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Bambu Lab, a Bambu Studio és a P2S a Bambu Lab védjegyei. A Bambu Bar független projekt, nem kapcsolódik a Bambu Labhez, és a Bambu Lab nem támogatja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Lab, Bambu Studio e P2S sono marchi di Bambu Lab. Bambu Bar è un progetto indipendente, non affiliato né approvato da Bambu Lab."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Lab、Bambu Studio、P2SはBambu Labの商標です。Bambu Barは独立したプロジェクトであり、Bambu Labとの提携や同社による承認はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Lab, Bambu Studio 및 P2S는 Bambu Lab의 상표입니다. Bambu Bar는 독립 프로젝트이며 Bambu Lab과 제휴하거나 Bambu Lab의 보증을 받지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Lab, Bambu Studio en P2S zijn handelsmerken van Bambu Lab. Bambu Bar is een onafhankelijk project, niet gelieerd aan of goedgekeurd door Bambu Lab."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Lab, Bambu Studio i P2S są znakami towarowymi Bambu Lab. Bambu Bar to niezależny projekt, niepowiązany z firmą Bambu Lab ani przez nią niepopierany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Lab, Bambu Studio e P2S são marcas registradas da Bambu Lab. O Bambu Bar é um projeto independente, sem afiliação com a Bambu Lab nem endossado por ela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Lab, Bambu Studio и P2S — товарные знаки Bambu Lab. Bambu Bar — независимый проект, не связанный с Bambu Lab и не одобренный ею."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Lab, Bambu Studio och P2S är varumärken som tillhör Bambu Lab. Bambu Bar är ett oberoende projekt som inte är anslutet till eller godkänt av Bambu Lab."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Lab, Bambu Studio ve P2S, Bambu Lab'in ticari markalarıdır. Bambu Bar bağımsız bir projedir; Bambu Lab ile bağlantılı değildir ve Bambu Lab tarafından onaylanmamıştır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Lab, Bambu Studio і P2S — торгові марки Bambu Lab. Bambu Bar — незалежний проєкт, не пов’язаний із Bambu Lab і не схвалений нею."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Lab、Bambu Studio 和 P2S 是 Bambu Lab 的商标。Bambu Bar 是独立项目，与 Bambu Lab 无关联，也未获得 Bambu Lab 的认可。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Lab、Bambu Studio 和 P2S 是 Bambu Lab 的商標。Bambu Bar 是獨立專案，與 Bambu Lab 無關，也未獲其背書。"
          }
        }
      }
    },
