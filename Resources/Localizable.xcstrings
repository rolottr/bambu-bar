          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén, tot %lld °C"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna, do %lld °C"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um, até %lld °C"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно, до %lld °C"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En, upp till %lld °C"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek, en fazla %lld °C"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одне, до %lld °C"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 个，最高 %lld °C"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個，最高 %lld °C"
          }
        }
      }
    },
    "Only Bambu Lab spools with an RFID tag report what’s left.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbývající množství hlásí jen cívky Bambu Lab se štítkem RFID."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Spulen von Bambu Lab mit RFID-Tag melden die Restmenge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo las bobinas Bambu Lab con etiqueta RFID indican lo que queda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les bobines Bambu Lab avec une étiquette RFID indiquent ce qu’il en reste."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak az RFID-címkés Bambu Lab tekercsek jelzik a maradékot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo le bobine Bambu Lab con tag RFID indicano il filamento rimasto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残量がわかるのは、RFIDタグ付きのBambu Labスプールのみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "RFID 태그가 있는 Bambu Lab 스풀만 남은 양을 알려 줍니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen Bambu Lab-spoelen met een RFID-tag geven door wat er nog op zit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko szpule Bambu Lab z tagiem RFID podają pozostałą ilość."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só carretéis Bambu Lab com etiqueta RFID informam quanto resta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток сообщают только катушки Bambu Lab с RFID-меткой."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast Bambu Lab-spolar med RFID-tagg rapporterar hur mycket som finns kvar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca RFID etiketli Bambu Lab makaraları kalan miktarı bildirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишок показують лише котушки Bambu Lab із міткою RFID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有带 RFID 标签的 Bambu Lab 料盘才会报告余量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有附 RFID 標籤的 Bambu Lab 料盤會回報剩餘量。"
          }
        }
      }
    },
    "Only in Bambu Bar, for the menu bar, window and widgets. The printer keeps its own name.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen v Bambu Bar, pro řádek nabídek, okno a widgety. Tiskárna si ponechá svůj vlastní název."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur in Bambu Bar, für Menüleiste, Fenster und Widgets. Der Drucker behält seinen eigenen Namen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo en Bambu Bar, para la barra de menús, la ventana y los widgets. La impresora conserva su propio nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement dans Bambu Bar, pour la barre des menus, la fenêtre et les widgets. L’imprimante garde son propre nom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a Bambu Bar alkalmazásban: a menüsorban, az ablakban és a widgeteken. A nyomtató megtartja a saját nevét."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo in Bambu Bar, per la barra dei menu, la finestra e i widget. La stampante mantiene il proprio nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar内（メニューバー、ウインドウ、ウィジェット）でのみ使用されます。プリンター自体の名前は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar의 메뉴 막대, 윈도우 및 위젯에만 적용됩니다. 프린터 자체 이름은 그대로 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen in Bambu Bar, voor de menubalk, het venster en de widgets. De printer houdt zijn eigen naam."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko w Bambu Bar: na pasku menu, w oknie i w widżetach. Drukarka zachowuje własną nazwę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só no Bambu Bar, para a barra de menus, a janela e os widgets. A impressora mantém o próprio nome."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только в Bambu Bar: для строки меню, окна и виджетов. Имя на самом принтере не изменится."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast i Bambu Bar, för menyraden, fönstret och widgetarna. Skrivaren behåller sitt eget namn."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca Bambu Bar'da; menü çubuğu, pencere ve widget'lar için. Yazıcı kendi adını korur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише в Bambu Bar: для смуги меню, вікна й віджетів. Принтер зберігає власну назву."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在 Bambu Bar 中使用，用于菜单栏、窗口和小组件。打印机自身的名称保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅用於 Bambu Bar 的選單列、視窗和小工具。印表機本身的名稱不變。"
          }
        }
      }
    },
    "Only in Bambu Bar. The printer still calls itself “%@”; rename it there in Bambu Handy.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen v Bambu Bar. Tiskárna se stále jmenuje „%@“; přejmenovat ji můžete v Bambu Handy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur in Bambu Bar. Der Drucker heißt weiterhin „%@“; umbenennen lässt er sich in Bambu Handy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo en Bambu Bar. La impresora sigue llamándose «%@»; cámbiele el nombre en Bambu Handy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement dans Bambu Bar. L’imprimante se nomme toujours « %@ » ; renommez-la dans Bambu Handy."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a Bambu Bar alkalmazásban. A nyomtató neve továbbra is „%@”; ott a Bambu Handy alkalmazásban nevezheted át."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo in Bambu Bar. La stampante si chiama ancora “%@”; per rinominarla lì usa Bambu Handy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar内でのみ有効です。プリンター自体の名前は「%@」のままです。プリンターの名前はBambu Handyで変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Bar에만 적용됩니다. 프린터 자체 이름은 여전히 “%@”입니다. 프린터 이름은 Bambu Handy에서 변경하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen in Bambu Bar. De printer heet zelf nog steeds “%@”; wijzig die naam in Bambu Handy."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko w Bambu Bar. Drukarka nadal nazywa się „%@”; jej nazwę zmienisz w Bambu Handy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só no Bambu Bar. A impressora continua se chamando “%@”; renomeie-a lá pelo Bambu Handy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только в Bambu Bar. Сам принтер по-прежнему называется «%@»; переименовать его можно в Bambu Handy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast i Bambu Bar. Skrivaren kallar sig fortfarande ”%@”; byt namn på den i Bambu Handy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca Bambu Bar'da. Yazıcının kendi adı hâlâ “%@”; yazıcıyı orada yeniden adlandırmak için Bambu Handy'yi kullan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише в Bambu Bar. Сам принтер і далі називається «%@»; перейменувати його можна в Bambu Handy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在 Bambu Bar 中生效。打印机自身的名称仍为“%@”；如需更改，请在 Bambu Handy 中重命名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅用於 Bambu Bar。印表機本身仍名為「%@」；請在 Bambu Handy 中重新命名。"
          }
        }
      }
    },
    "Only the IP address is needed: it's on the printer's screen under Settings → Network. Bambu Bar reads the serial number from the printer.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stačí IP adresa: najdete ji na obrazovce tiskárny v Nastavení → Síť. Sériové číslo si Bambu Bar načte z tiskárny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die IP-Adresse wird benötigt: Sie steht auf dem Druckerdisplay unter Einstellungen → Netzwerk. Bambu Bar liest die Seriennummer vom Drucker aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se necesita la dirección IP: está en la pantalla de la impresora, en Configuración → Red. Bambu Bar lee el número de serie de la impresora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule l’adresse IP est nécessaire : elle figure sur l’écran de l’imprimante sous Paramètres → Réseau. Bambu Bar lit le numéro de série directement sur l’imprimante."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak az IP-cím kell: a nyomtató képernyőjén található, a Beállítások → Hálózat menüben. A sorozatszámot a Bambu Bar olvassa ki a nyomtatóból."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve solo l'indirizzo IP: si trova sullo schermo della stampante in Impostazioni → Rete. Bambu Bar legge il numero di serie dalla stampante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要なのはIPアドレスだけです。プリンターの画面の「設定 → ネットワーク」に表示されています。シリアル番号はBambu Barがプリンターから読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "IP 주소만 있으면 됩니다. 프린터 화면의 설정 → 네트워크에서 확인할 수 있습니다. 일련번호는 Bambu Bar가 프린터에서 읽어 옵니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen het IP-adres is nodig: dat staat op het scherm van de printer onder Instellingen → Netwerk. Bambu Bar leest het serienummer uit de printer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wystarczy adres IP: znajdziesz go na ekranie drukarki w: Ustawienia → Sieć. Bambu Bar odczyta numer seryjny z drukarki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só é preciso o endereço IP: ele está na tela da impressora em Configurações → Rede. O Bambu Bar lê o número de série da impressora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен только IP-адрес: он указан на экране принтера в разделе Настройки → Сеть. Серийный номер Bambu Bar считает с принтера."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara IP-adressen behövs: den finns på skrivarens skärm under Inställningar → Nätverk. Bambu Bar läser serienumret från skrivaren."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca IP adresi gerekli: Yazıcının ekranında Ayarlar → Ağ altında bulunur. Bambu Bar seri numarasını yazıcıdan okur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібна лише IP-адреса: вона є на екрані принтера в розділі Налаштування → Мережа. Серійний номер Bambu Bar зчитає з принтера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只需 IP 地址即可：可在打印机屏幕的“设置 → 网络”中找到。Bambu Bar 会从打印机读取序列号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只需要 IP 位址：可在印表機螢幕的「設定 → 網路」中找到。Bambu Bar 會從印表機讀取序號。"
          }
        }
      }
    },
