    "That address didn't answer as Moonraker.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato adresa neodpověděla jako Moonraker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter dieser Adresse antwortete kein Moonraker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa dirección no respondió como Moonraker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse n’a pas répondu comme Moonraker."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a cím nem Moonrakerként válaszolt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quell'indirizzo non ha risposto come Moonraker."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのアドレスはMoonrakerとして応答しませんでした。"
