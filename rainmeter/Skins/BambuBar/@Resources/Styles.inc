; The sections every meter inherits from (@Inherit, Rainmeter 5.0: https://www.rainmeter.net/changes-5.0/).
; Everything starts hidden; Scripts\widget.lua shows what a state needs. All content meters sit in the Content
; container, whose alpha fades them together on a state change.

[StyleText]
Container=Content
Hidden=1
AntiAlias=1
FontFace=Segoe UI
FontSize=9
FontColor=F2F2F5FF
ClipString=1
Text=

[StyleShape]
Container=Content
Hidden=1
AntiAlias=1
Shape=Rectangle 0,0,1,1 | Fill Color 00000000 | StrokeWidth 0

[StyleIcon]
Container=Content
Hidden=1
W=10
H=10

[StyleArt]
Container=Content
Hidden=1
PreserveAspectRatio=1
